	<parameter name="band1B" class="java.lang.Integer"/>
	<parameter name="band2A" class="java.lang.Integer"/>
	<parameter name="band2B" class="java.lang.Integer"/>
	<parameter name="band3A" class="java.lang.Integer"/>
	<parameter name="band3B" class="java.lang.Integer"/>
	<parameter name="band4A" class="java.lang.Integer"/>
	<parameter name="band4B" class="java.lang.Integer"/>
	<parameter name="band5A" class="java.lang.Integer"/>
	<parameter name="band5B" class="java.lang.Integer"/>
	<parameter name="asOnDate" class="java.lang.String"/>
	<parameter name="band1" class="java.lang.String"/>
	<parameter name="band2" class="java.lang.String"/>
	<parameter name="band3" class="java.lang.String"/>
	<parameter name="band4" class="java.lang.String"/>
	<parameter name="band5" class="java.lang.String"/>
	<parameter name="acctName" class="java.lang.String"/>
	<parameter name="localForeign" class="java.lang.String"/>
	<parameter name="parentId" class="java.lang.String"/>
	<parameter name="currencyId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT ageing.code_combination_id,cc.acct_name,ageing.band1total,ageing.band2total,ageing.band3total,ageing.band4total,
         ageing.band5total,(band1total+band2total+band3total+band4total+band5total) as total
FROM (SELECT ps.code_combination_id,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) < $P{band2A}
	THEN amount_due_remain ELSE 0 END) band1total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band1B} AND datediff(d,ps.due_date,getdate()) < $P{band3A}
	THEN amount_due_remain ELSE 0 END) band2total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band2B} AND datediff(d,ps.due_date,getdate()) < $P{band4A}
	THEN amount_due_remain ELSE 0 END) band3total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band3B} AND datediff(d,ps.due_date,getdate()) < $P{band5A}
	THEN amount_due_remain ELSE 0 END) band4total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band4B}
	THEN amount_due_remain ELSE 0 END) band5total
     FROM gl_payment_schedule_f ps
     INNER JOIN gl_code_combination_d cc ON (cc.code_combination_id = ps.code_combination_id AND cc.parent_id IN (22,29))
     INNER JOIN gl_je_f je ON (je.je_hdr_id = ps.je_hdr_id AND je.hdr_line_flag='H' AND je.je_source IN ('INVOICE','EXPENSE'))
     LEFT OUTER JOIN ar_customer_trx_f trx ON (trx.customer_trx_id = je.je_source_hdr_id)
     WHERE ref_type NOT IN (4) AND ps.company_id = $P{companyId} AND trx.local_foreign LIKE $P{localForeign}
     AND ps.currency_id = $P{currencyId}
     GROUP BY ps.code_combination_id,ps.company_id,ps.ref_type,ps.dr_cr) ageing
     INNER JOIN gl_code_combination_d cc ON (cc.code_combination_id = ageing.code_combination_id)
     WHERE (band1total+band2total+band3total+band4total+band5total) <> 0
     AND cc.acct_name LIKE $P{acctName}
     AND ageing.code_combination_id IN (SELECT code_combination_id FROM gl_code_combination_d WHERE parent_id LIKE $P{parentId})]]>
	</queryString>
	<field name="codeCombinationId" class="java.lang.Integer"/>
	<field name="acctName" class="java.lang.String"/>
