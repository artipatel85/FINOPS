				</graphicElement>
			</line>
			<textField>
				<reportElement x="384" y="8" width="71" height="17"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{totalDR}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="465" y="8" width="71" height="17"/>
				<textElement textAlignment="Right">
