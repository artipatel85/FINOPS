<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Bank_rec" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="2"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="companyId" class="java.lang.Integer"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="lineAcctId" class="java.lang.Integer"/>
	<parameter name="band1A" class="java.lang.Integer"/>
	<parameter name="band1B" class="java.lang.Integer"/>
	<parameter name="band2A" class="java.lang.Integer"/>
	<parameter name="band2B" class="java.lang.Integer"/>
	<parameter name="band3A" class="java.lang.Integer"/>
	<parameter name="band3B" class="java.lang.Integer"/>
	<parameter name="band4A" class="java.lang.Integer"/>
	<parameter name="band4B" class="java.lang.Integer"/>
	<parameter name="band5A" class="java.lang.Integer"/>
	<parameter name="band5B" class="java.lang.Integer"/>
	<parameter name="asOnDate" class="java.lang.String"/>
	<parameter name="band1" class="java.lang.String"/>
	<parameter name="band2" class="java.lang.String"/>
	<parameter name="band3" class="java.lang.String"/>
	<parameter name="band4" class="java.lang.String"/>
	<parameter name="band5" class="java.lang.String"/>
	<parameter name="acctName" class="java.lang.String"/>
	<parameter name="salesMan" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ageing.band1total,ageing.band2total,ageing.band3total,ageing.band4total,
         ageing.band5total,(band1total+band2total+band3total+band4total+band5total) as total,ageing.sales_by
FROM (SELECT trx.sales_by,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) < $P{band2A}
	THEN amount_due_remain ELSE 0 END) band1total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band1B} AND datediff(d,ps.due_date,getdate()) < $P{band3A}
	THEN amount_due_remain ELSE 0 END) band2total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band2B} AND datediff(d,ps.due_date,getdate()) < $P{band4A}
	THEN amount_due_remain ELSE 0 END) band3total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band3B} AND datediff(d,ps.due_date,getdate()) < $P{band5A}
	THEN amount_due_remain ELSE 0 END) band4total,
     SUM(CASE WHEN datediff(d,ps.due_date,$P{asOnDate}) > $P{band4B}
	THEN amount_due_remain ELSE 0 END) band5total
     FROM gl_payment_schedule_f ps
     INNER JOIN gl_code_combination_d cc ON (cc.code_combination_id = ps.code_combination_id)
     LEFT OUTER JOIN gl_je_f je ON (je.je_hdr_id = ps.je_hdr_id AND je.hdr_line_flag='H')
     LEFT OUTER JOIN ar_customer_trx_f trx ON (trx.customer_trx_id = je.je_source_hdr_id)
     WHERE ps.ref_type NOT IN (4) AND ps.company_id = $P{companyId} AND dr_cr = 'DR'
     GROUP BY ps.company_id,ref_type,dr_cr,sales_by) ageing
     WHERE (band1total+band2total+band3total+band4total+band5total) <> 0
     AND ageing.sales_by LIKE $P{salesMan}]]>
	</queryString>
	<field name="band1total" class="java.math.BigDecimal"/>
	<field name="band2total" class="java.math.BigDecimal"/>
	<field name="band3total" class="java.math.BigDecimal"/>
	<field name="band4total" class="java.math.BigDecimal"/>
	<field name="band5total" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="sales_by" class="java.lang.String"/>
	<variable name="PAGE_TOTAL" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal(0.00)]]></initialValueExpression>
	</variable>
