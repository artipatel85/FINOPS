	<queryString>
		<![CDATA[select je.code_combination_id,je.entered_dr,je.je_hdr_id,je.je_line_id
,je.je_line_remarks
,je.bl_no
,cc.acct_name as code_desc
,je.entered_dr
,je.entered_cr
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
where je.je_source='DEBIT' and je.hdr_line_flag='L' and je.je_voucher_no=$P{trxno}]]>
