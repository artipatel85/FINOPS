	<queryString>
		<![CDATA[SELECT arl.code_combination_id,arl.code_desc,arl.taxable_1,
                arl.taxable_2,arl.taxable_3,arl.taxable_4,arl.taxable_5,arl.non_taxable,
                arl.per_on_tot_val,arl.per_on_val,arl.discount_per,arl.discount_amt,
                arl.oth_chrgs_per,arl.oth_chrgs_amt,arl.status,
                arl.entered_amount,arl.remark,arl.template_id,accounted_amount
                FROM ar_customer_trx_lines_f arl
                WHERE arl.customer_trx_id =  $P{trxid}
                AND arl.rev_exp_tax_disc_oc = 'R'
		AND arl.accounted_amount > 0
                ORDER BY arl.template_id DESC]]>
	</queryString>
