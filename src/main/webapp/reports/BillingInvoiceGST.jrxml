	<subDataset name="GSTDATASET">
		<parameter name="trxid" class="java.lang.Integer"/>
		<parameter name="nontaxable" class="java.math.BigDecimal"/>
		<parameter name="taxable" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[SELECT arl.code_combination_id,arl.code_desc,arl.taxable_1,
                arl.taxable_2,arl.taxable_3,arl.taxable_4,arl.taxable_5,arl.non_taxable,
                arl.per_on_tot_val,arl.per_on_val,arl.discount_per,arl.discount_amt,
                arl.oth_chrgs_per,arl.oth_chrgs_amt,arl.status,
                arl.entered_amount,arl.remark,arl.template_id,accounted_amount
                FROM ar_customer_trx_lines_f arl
                WHERE arl.customer_trx_id =  $P{trxid}
                AND arl.rev_exp_tax_disc_oc = 'R'
		AND arl.accounted_amount > 0
                ORDER BY arl.template_id DESC]]>
		</queryString>
		<field name="code_combination_id" class="java.lang.Integer"/>
		<field name="code_desc" class="java.lang.String"/>
		<field name="taxable_1" class="java.lang.String"/>
		<field name="taxable_2" class="java.lang.String"/>
		<field name="taxable_3" class="java.lang.String"/>
		<field name="taxable_4" class="java.lang.String"/>
		<field name="taxable_5" class="java.lang.String"/>
		<field name="non_taxable" class="java.lang.String"/>
		<field name="per_on_tot_val" class="java.math.BigDecimal"/>
		<field name="per_on_val" class="java.math.BigDecimal"/>
		<field name="discount_per" class="java.math.BigDecimal"/>
		<field name="discount_amt" class="java.math.BigDecimal"/>
		<field name="oth_chrgs_per" class="java.math.BigDecimal"/>
		<field name="oth_chrgs_amt" class="java.math.BigDecimal"/>
		<field name="status" class="java.lang.String"/>
		<field name="entered_amount" class="java.math.BigDecimal"/>
		<field name="remark" class="java.lang.String"/>
		<field name="template_id" class="java.lang.Integer"/>
		<field name="accounted_amount" class="java.math.BigDecimal"/>
		<variable name="TOTAL_REVENUE" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$P{nontaxable}.add($P{taxable})]]></variableExpression>
		</variable>
	</subDataset>
