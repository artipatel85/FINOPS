	<parameter name="CASH_BANK" class="java.lang.String"/>
	<parameter name="je_voucher_no" class="java.lang.String"/>
	<parameter name="je_date" class="java.lang.String"/>
	<parameter name="acct_year" class="java.lang.String"/>
	<parameter name="company_name" class="java.lang.String"/>
	<parameter name="entered_dr" class="java.lang.String"/>
	<parameter name="remarks" class="java.lang.String"/>
	<parameter name="CHANGEWORD" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="acct_name" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select je.code_combination_id,je.entered_dr,je.je_hdr_id,je.je_line_id
,je.je_line_remarks
,je.bl_no
,case when cast(cost.bl_no as varchar)<> '' then 'B/L : '+ cost.bl_no  else '' end as cc_name
,case when cast(je.entered_cr as varchar) = '0.00' then 'Less : '+cc.acct_name  else cc.acct_name end as acct_name
,case when cast(je.entered_cr as varchar) = '0.00' then je.entered_dr  else je.entered_cr end as entered_cr
,case when cast(je.entered_cr as varchar) = '0.00' then '(-)'  else '' end as LESS



,case when( cast(je.chq_no as varchar) <> '-' and cast(je.chq_no as varchar)<>'')then 'Cheque No : '+je.chq_no  else '' end as chq_no
 ,case when je.chq_date  <> '' then 'Dated : '+convert(char(10),je.chq_date,120)  else '' end as chqDate
,je.created_by,je.amended_by,je.amended_date
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
left outer join bl_hdr_f cost on(je.bl_no=cost.bl_no)
where je.je_source='DEBIT' and je.hdr_line_flag='L' and je.je_voucher_no=$P{je_voucher_no}
group by je.bl_no,cost.bl_no,je.code_combination_id,je.entered_cr,je.entered_dr,cc.acct_name,je.je_hdr_id,je.je_line_id,je.je_line_remarks,je.chq_no,je.je_line_remarks,je.chq_no,je.chq_date,je.created_by,je.amended_by,je.amended_date
order by je.je_line_id]]>
	</queryString>
