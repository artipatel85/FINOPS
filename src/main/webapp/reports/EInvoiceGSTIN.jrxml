	<subDataset name="INVOICEDS">
		<parameter name="trxid" class="java.lang.String"/>
		<parameter name="taxable" class="java.math.BigDecimal"/>
		<parameter name="nontaxable" class="java.math.BigDecimal"/>
		<parameter name="taxamount1" class="java.math.BigDecimal"/>
		<parameter name="taxamount2" class="java.math.BigDecimal"/>
		<parameter name="taxamount3" class="java.math.BigDecimal"/>
		<parameter name="grandtotal" class="java.math.BigDecimal"/>
		<parameter name="inwords" class="java.lang.String"/>
		<parameter name="totalTax" class="java.math.BigDecimal"/>
		<parameter name="discount" class="java.math.BigDecimal"/>
		<parameter name="templateType" class="java.lang.String"/>
		<parameter name="signedQRCode" class="java.lang.String"/>
		<parameter name="irn" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT arl.code_combination_id,(arl.code_desc+' '+arl.REMARK) code_desc,arl.taxable_1,
                arl.taxable_2,arl.taxable_3,arl.taxable_4,arl.taxable_5,arl.non_taxable,
                arl.per_on_tot_val,arl.per_on_val,arl.discount_per,arl.discount_amt,
                arl.oth_chrgs_per,arl.oth_chrgs_amt,arl.status,
                arl.entered_amount,arl.remark,arl.template_id,accounted_amount,sac_code,tax_1_per,
                tax_2_per,tax_3_per,tax_4_per,tax_5_per,tax_1_val,
                tax_2_val,tax_3_val,tax_4_val,tax_5_val,
               (tax_1_val+ tax_2_val+ tax_3_val+ tax_4_val+ tax_5_val) totalGST
                FROM ar_customer_trx_lines_f arl
                WHERE arl.customer_trx_id =  $P{trxid}
                AND  arl.rev_exp_tax_disc_oc = 'R'
		AND arl.accounted_amount > 0
                ORDER BY arl.template_id DESC]]>
		</queryString>
		<field name="tax_1_per" class="java.math.BigDecimal"/>
		<field name="tax_2_per" class="java.math.BigDecimal"/>
		<field name="sac_code" class="java.lang.String"/>
		<field name="code_combination_id" class="java.lang.Integer"/>
		<field name="tax_3_per" class="java.math.BigDecimal"/>
		<field name="code_desc" class="java.lang.String"/>
		<field name="entered_amount" class="java.math.BigDecimal"/>
		<field name="non_taxable" class="java.lang.String"/>
		<field name="tax_1_val" class="java.math.BigDecimal"/>
		<field name="tax_2_val" class="java.math.BigDecimal"/>
		<field name="tax_3_val" class="java.math.BigDecimal"/>
		<field name="tax_4_val" class="java.math.BigDecimal"/>
		<field name="remark" class="java.lang.String"/>
		<field name="totalGST" class="java.math.BigDecimal"/>
		<variable name="TOTAL_REVENUE" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$P{nontaxable}.add($P{taxable})]]></variableExpression>
		</variable>
		<variable name="TAX_TYPE_SU" class="java.lang.String">
			<variableExpression><![CDATA[$P{templateType}.equals( "UTGST" )?"UTGST":"SGST"]]></variableExpression>
		</variable>
	</subDataset>
