	<queryString><![CDATA[SELECT coalesce(SUM(XX.DR_4),0)period_4_net_dr,coalesce(SUM(XX.CR_4),0)period_4_net_cr,coalesce(SUM(XX.DR_5),0)period_5_net_dr,coalesce(SUM(XX.CR_5),0)period_5_net_cr,coalesce(SUM(XX.DR_6),0)period_6_net_dr,coalesce(SUM(XX.CR_6),0)period_6_net_cr, coalesce(SUM(XX.DR_7),0)period_7_net_dr,coalesce(SUM(XX.CR_7),0)period_7_net_cr, coalesce(SUM(XX.DR_8),0)period_8_net_dr,coalesce(SUM(XX.CR_8),0)period_8_net_cr, coalesce(SUM(XX.DR_9),0)period_9_net_dr,coalesce(SUM(XX.CR_9),0)period_9_net_cr, coalesce(SUM(XX.DR_10),0)period_10_net_dr,coalesce(SUM(XX.CR_10),0)period_10_net_cr, coalesce(SUM(XX.DR_11),0)period_11_net_dr,coalesce(SUM(XX.CR_11),0)period_11_net_cr, coalesce(SUM(XX.DR_12),0)period_12_net_dr,coalesce(SUM(XX.CR_12),0)period_12_net_cr, coalesce(SUM(XX.DR_1),0)period_1_net_dr,coalesce(SUM(XX.CR_1),0)period_1_net_cr, coalesce(SUM(XX.DR_2),0)period_2_net_dr,coalesce(SUM(XX.CR_2),0)period_2_net_cr, coalesce(SUM(XX.DR_3),0)period_3_net_dr,coalesce(SUM(XX.CR_3),0)period_3_net_cr FROM( SELECT CASE WHEN MONTH(je_date) = '4' THEN coalesce(sum(accounted_dr),0) END DR_4 ,CASE WHEN MONTH(je_date) = '4' THEN coalesce(sum(accounted_cr),0) END CR_4 ,CASE WHEN MONTH(je_date) = '5' THEN coalesce(sum(accounted_dr),0) END DR_5 ,CASE WHEN MONTH(je_date) = '5' THEN coalesce(sum(accounted_cr),0) END CR_5 ,CASE WHEN MONTH(je_date) = '6' THEN coalesce(sum(accounted_dr),0) END DR_6 ,CASE WHEN MONTH(je_date) = '6' THEN coalesce(sum(accounted_cr),0) END CR_6 ,CASE WHEN MONTH(je_date) = '7' THEN coalesce(sum(accounted_dr),0) END DR_7 ,CASE WHEN MONTH(je_date) = '7' THEN coalesce(sum(accounted_cr),0) END CR_7 ,CASE WHEN MONTH(je_date) = '8' THEN coalesce(sum(accounted_dr),0) END DR_8 ,CASE WHEN MONTH(je_date) = '8' THEN coalesce(sum(accounted_cr),0) END CR_8 ,CASE WHEN MONTH(je_date) = '9' THEN coalesce(sum(accounted_dr),0) END DR_9 ,CASE WHEN MONTH(je_date) = '9' THEN coalesce(sum(accounted_cr),0) END CR_9 ,CASE WHEN MONTH(je_date) = '10' THEN coalesce(sum(accounted_dr),0) END DR_10 ,CASE WHEN MONTH(je_date) = '10' THEN coalesce(sum(accounted_cr),0) END CR_10 ,CASE WHEN MONTH(je_date) = '11' THEN coalesce(sum(accounted_dr),0) END DR_11 ,CASE WHEN MONTH(je_date) = '11' THEN coalesce(sum(accounted_cr),0) END CR_11 ,CASE WHEN MONTH(je_date) = '12' THEN coalesce(sum(accounted_dr),0) END DR_12 ,CASE WHEN MONTH(je_date) = '12' THEN coalesce(sum(accounted_cr),0) END CR_12 ,CASE WHEN MONTH(je_date) = '1' THEN coalesce(sum(accounted_dr),0) END DR_1 ,CASE WHEN MONTH(je_date) = '1' THEN coalesce(sum(accounted_cr),0) END CR_1 ,CASE WHEN MONTH(je_date) = '2' THEN coalesce(sum(accounted_dr),0) END DR_2 ,CASE WHEN MONTH(je_date) = '2' THEN coalesce(sum(accounted_cr),0) END CR_2 ,CASE WHEN MONTH(je_date) = '3' THEN coalesce(sum(accounted_dr),0) END DR_3 ,CASE WHEN MONTH(je_date) = '3' THEN coalesce(sum(accounted_cr),0) END CR_3 FROM gl_je_f  
WHERE   je_source in('STNPUR','GENPUR')  
and hdr_line_flag='L'  and company_id='1001'  
and acct_year=$P{acctYear}
group by MONTH(je_date) ) XX]]></queryString>

