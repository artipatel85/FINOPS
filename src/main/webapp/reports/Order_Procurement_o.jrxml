	<parameter name="VENDOR_TO_CC_FAX" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FIELD_REP" isForPrompting="false" class="java.lang.String"/>
	<parameter name="ORDER_BOOKED_DATE" isForPrompting="false" class="java.lang.String"/>
	<parameter name="ORDER_NUMBER" isForPrompting="false" class="java.lang.String"/>
	<parameter name="PI_NUMBER" isForPrompting="false" class="java.lang.String"/>
	<parameter name="ccCC_NAME" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select fh.fmo_hdr_id 
      ,fh.fmo_number
      ,fh.fmo_date
      ,ooh.order_number
      ,ooh.cust_po_number
      ,fl.inventory_item_id
      ,fl.uom_id trx_uom
      ,mii.item_desc
      ,mii.uom_id
      ,fh.to_cc_id 
      ,fh.vendor_id
      ,fl.mo_qty
      ,uom.uom_symbol
,CASE WHEN fh.TO_CC_ID <> 0 
                THEN TO_CC.CC_NAME   ELSE VENDOR.VENDOR_NAME END VENDOR_TO_CC_NAME
  from fmo_hdr_f fh
inner join fmo_line_f fl
  on (fh.fmo_hdr_id = fl.fmo_hdr_id)
inner join om_pi_hdr_f oph
  on (fh.pi_hdr_id = oph.pi_hdr_id
 and fh.company_id = oph.company_id)
inner join om_order_hdr_f ooh
  on (oph.order_hdr_id = ooh.order_hdr_id
 and oph.company_id = ooh.company_id)
inner join mtl_inventory_item_d mii
  on (fl.inventory_item_id = mii.inventory_item_id)
inner join uom_d uom on(uom.uom_id=fl.uom_id)
 LEFT OUTER JOIN COST_CENTER_D TO_CC ON (TO_CC.CC_ID = fh.TO_CC_ID)  
 LEFT OUTER JOIN VENDOR_D VENDOR ON (VENDOR.VENDOR_ID = fh.VENDOR_ID) 
where ooh.order_number = $P{ORDER_NUMBER}
 and fh.company_id = $P{COMPANY_ID}]]></queryString>

