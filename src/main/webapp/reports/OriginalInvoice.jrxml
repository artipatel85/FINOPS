	<parameter name="DS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="disc" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT   line.customer_trx_id,(dist.discount+SUM(line.sea_freight+line.other_charges)) inv_qty
FROM ar_customer_trx_line_f line
INNER JOIN (SELECT   customer_trx_id,(SUM(inv_qty*item_rate)-SUM(discount)) discount FROM ar_customer_trx_dist_f GROUP BY customer_trx_id) dist
ON (line.customer_trx_id = dist.customer_trx_id) 
WHERE line.CUSTOMER_TRX_ID= $P{CUSTOMER_TRX_ID}
GROUP BY line.customer_trx_id,dist.discount]]></queryString>

	<field name="customer_trx_id" class="java.lang.Integer"/>
	<field name="inv_qty" class="java.lang.Double"/>

	<variable name="INWORDS" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new com.avance.erp.util.ApplicationUtil().convertDoubleToWord($F{inv_qty},$P{CURRENCY},$P{NUMERAL})]]></variableExpression>
	</variable>
