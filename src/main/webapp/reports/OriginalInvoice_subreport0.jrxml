	<parameter name="CUSTOMER_TRX_ID" isForPrompting="true" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT     line.CUSTOMER_TRX_LINE_ID
, line.CUSTOMER_TRX_ID
, upper(line.CONTAINER_NO)CONTAINER_NO,line.NO_KIND_OF_PKGS
, dist.XREF_ID, dist.INVENTORY_ITEM_ID,item.item_code,item.item_desc
,dist.UOM_ID,dist.CUSTOMER_TRX_DIST_ID,dist.size
, dist.INV_QTY, dist.INV_CONV_QTY
, dist.ITEM_RATE,dist.DISCOUNT_PER
, dist.DISCOUNT
,CASE WHEN cast(dist.DISCOUNT as varchar)='0.00' THEN  '' ELSE 'LESS DISCOUNT AMOUNT' END AS discountsub
,line.line_remarks
, hdr.CUSTOMER_TRX_ID AS Expr1
, (dist.item_rate * dist.inv_qty)amount
,line.OTHER_CHARGES 

,CASE WHEN cast(line.OTHER_CHARGES as varchar)='0.00' THEN  '' ELSE cast(line.OTHER_CHARGES as varchar) END AS OC
,CASE WHEN cast(line.OTHER_CHARGES as varchar)='0.00' THEN  '' ELSE 'OTHER CHARGES' END AS other

,line.SEA_FREIGHT 

,CASE WHEN cast(line.SEA_FREIGHT as varchar)='0.00' THEN  '' ELSE cast(line.SEA_FREIGHT as varchar) END AS SF
,CASE WHEN cast(line.SEA_FREIGHT as varchar)='0.00' THEN  '' ELSE 'SEA FREIGHT' END AS sea
,line.pi_hdr_id,pihdr.pi_number,pihdr.pi_date,orderhdr.cust_po_number,orderhdr.cust_po_date
FROM  ar_customer_trx_line_f line
 INNER JOIN ar_customer_trx_dist_f dist ON (dist.CUSTOMER_TRX_LINE_ID = line.CUSTOMER_TRX_LINE_ID )
INNER JOIN ar_customer_trx_f hdr ON (line.CUSTOMER_TRX_ID = hdr.CUSTOMER_TRX_ID)
LEFT OUTER JOIN om_pi_hdr_f pihdr ON (pihdr.pi_hdr_id = line.pi_hdr_id)
LEFT OUTER JOIN om_order_hdr_f orderhdr ON (orderhdr.order_hdr_id = pihdr.order_hdr_id)
LEFT OUTER JOIN mtl_inventory_item_d item ON (item.inventory_item_id = dist.inventory_item_id)
 where line.CUSTOMER_TRX_ID= $P{CUSTOMER_TRX_ID}]]></queryString>

