<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OutputServiceTax" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String"/>
	<parameter name="acctYear" class="java.lang.Integer"/>
	<parameter name="companyId" class="java.lang.Integer"/>
	<parameter name="codeCombinationId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT DISTINCT h.trx_number,CONVERT(CHAR(10),h.trx_date,120) trx_date,
                l.accounted_amount totalServiceTax,
                ROUND(l.accounted_amount/1.03, 3) ST12PCT,
                ROUND((l.accounted_amount*0.02)/1.03,3) EDUCESS,
                ROUND((l.accounted_amount*0.01)/1.03,3) HIGHEDUCESS
                FROM ar_customer_trx_f h
                INNER JOIN ar_customer_trx_lines_f l ON (h.CUSTOMER_TRX_ID = l.customer_trx_id
                AND l.code_combination_id IN ($P{codeCombinationId}) AND l.REV_EXP_TAX_DISC_OC = 'T')
                INNER JOIN gl_je_f je ON (je.JE_SOURCE IN ('INVOICE','EXPENSE')
                AND je.je_source_hdr_id = h.customer_trx_id
                AND je.ACCT_YEAR = $P{acctYear} AND je.COMPANY_ID = $P{companyId}) AND l.REV_EXP_TAX_DISC_OC = 'T'
                AND h.trx_date BETWEEN $P{startDate} AND $P{endDate}]]>
	</queryString>
	<field name="trx_number" class="java.lang.String"/>
	<field name="trx_date" class="java.lang.String"/>
	<field name="totalServiceTax" class="java.math.BigDecimal"/>
	<field name="ST12PCT" class="java.math.BigDecimal"/>
	<field name="EDUCESS" class="java.math.BigDecimal"/>
	<field name="HIGHEDUCESS" class="java.math.BigDecimal"/>
	<variable name="TOTAL_STAX" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalServiceTax}]]></variableExpression>
	</variable>
	<columnHeader>
		<band height="37" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="5" width="40" height="13"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[INV NO]]></text>
			</staticText>
			<staticText>
				<reportElement x="44" y="5" width="42" height="13"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[INV DATE]]></text>
			</staticText>
			<staticText>
				<reportElement x="95" y="5" width="33" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[S.TAX]]></text>
			</staticText>
			<staticText>
				<reportElement x="135" y="5" width="32" height="28"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[EDU CESS]]></text>
			</staticText>
			<staticText>
				<reportElement x="174" y="5" width="41" height="28"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[HIGH EDU CESS]]></text>
			</staticText>
			<staticText>
				<reportElement x="216" y="5" width="44" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="2" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="0" y="33" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="0" y="35" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="263" y="2" width="1" height="35"/>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="16" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="40" height="13"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{trx_number}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="44" y="0" width="43" height="13"/>
				<textElement>
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{trx_date}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="216" y="0" width="44" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{totalServiceTax}.setScale(2,BigDecimal.ROUND_HALF_UP)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="95" y="0" width="32" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{ST12PCT}.setScale(2,BigDecimal.ROUND_HALF_UP)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="134" y="0" width="33" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{EDUCESS}.setScale(2,BigDecimal.ROUND_HALF_UP)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="174" y="0" width="41" height="13"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{HIGHEDUCESS}.setScale(2,BigDecimal.ROUND_HALF_UP)]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="15" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="263" y="-2" width="1" height="18"/>
			</line>
		</band>
	</detail>
</jasperReport>
