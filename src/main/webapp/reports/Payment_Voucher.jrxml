	<parameter name="acct_year" class="java.lang.String"/>
	<parameter name="company_name" class="java.lang.String"/>
	<parameter name="entered_cr" class="java.lang.String"/>
	<parameter name="remarks" class="java.lang.String"/>
	<parameter name="CHANGEWORD" class="java.lang.String"/>
	<parameter name="ADDRESS" class="java.lang.String"/>
	<queryString>
		<![CDATA[select je.code_combination_id,je.entered_dr,je.je_hdr_id,je.je_line_id
,je.je_line_remarks
,case when (je.entered_dr = '0.00') then je.entered_cr  else je.entered_dr end as entered_dr
,case when (je.entered_dr = '0.00') then '(-)'  else '' end as LESS
,case when (je.chq_no <> '-' and je.chq_no <> '') then concat('Cheque No : ', je.chq_no)  else '' end as chq_no
 ,case when (je.chq_date  IS NOT NULL) then concat('Dated : ',je.chq_date)  else '' end as chqDate,cc.acct_name
,je.created_by,je.amended_by,je.amended_date
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
where je.je_source='PAYMENT' and je.hdr_line_flag='L' and je.je_voucher_no=$P{je_voucher_no} and je.acct_year=$P{acct_year}
group by je.code_combination_id,je.entered_cr,je.entered_dr,je.je_hdr_id,je.je_line_id,je.je_line_remarks,je.chq_no,je.je_line_remarks,je.chq_no,je.chq_date,cc.acct_name,je.created_by,je.amended_by,je.amended_date
order by je.je_line_id]]>
	</queryString>
