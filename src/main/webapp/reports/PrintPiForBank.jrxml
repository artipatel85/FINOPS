	<queryString><![CDATA[SELECT pcl.ITEM_DESCRIPTION
,PCL.ITEM_SIZE
,PCL.UOM_ID
,PCL.ITEM_RATE
,pcl.QTY
,uom.uom_desc uom
,CAST(( PCL.ITEM_RATE  *  QTY )AS DECIMAL(15,2))AS AMOUNT 
  FROM pcl_pi_line_f pcl 
  LEFT OUTER JOIN uom_d uom ON (uom.uom_id = pcl.uom_id) 
             
 where pcl.pcl_pi_hdr_id=$P{PCL_PI_HDR_ID}]]></queryString>

	<field name="ITEM_DESCRIPTION" class="java.lang.String"/>
	<field name="ITEM_SIZE" class="java.lang.String"/>
	<field name="UOM_ID" class="java.lang.String"/>
	<field name="QTY" class="java.lang.Float"/>
	<field name="ITEM_RATE" class="java.lang.Float"/>
	<field name="AMOUNT" class="java.lang.Float"/>
	<field name="uom" class="java.lang.String"/>

	<variable name="TOTALAMT" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{AMOUNT}.doubleValue())]]></variableExpression>
	</variable>
