	<queryString><![CDATA[SELECT convert(char(10)
,pcl.pcl_pi_date,120)pcl_pi_date1,pcl.*
,cur.currency_short_name,cc.acct_name buyerName,ltr.ref_no,convert(char(10)
,ltr.ref_date,120)ref_date,ltr.bank_cc_id,bank.ACCT_NAME BANKNAME 
,ltr.our_current_acct,ltr.PCL_REQ_FC_AMT,pcl.pcl_received_amt 
FROM pcl_pi_hdr_f pcl 
LEFT OUTER JOIN PCL_BANK_LTR_F ltr ON (ltr.pcl_pi_hdr_id = pcl.pcl_pi_hdr_id)
 LEFT OUTER JOIN gl_code_combination_d cc ON (cc.code_combination_id = pcl.buyer_id) 
LEFT OUTER JOIN gl_code_combination_d bank ON (bank.code_combination_id = ltr.bank_cc_id)
 LEFT OUTER JOIN currency_d cur ON (cur.currency_id = pcl.currency_id)
 where pcl.pcl_pi_hdr_id=$P{PCL_PI_HDR_ID} 	]]></queryString>

