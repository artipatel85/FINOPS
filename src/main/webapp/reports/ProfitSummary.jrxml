<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProfitSummary" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="blNo" class="java.lang.String"/>
	<parameter name="jobNo" class="java.lang.String"/>
	<parameter name="loadingAgent" class="java.lang.String"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="seaAir" class="java.lang.String"/>
	<parameter name="exportImport" class="java.lang.String"/>
	<parameter name="salesMan" class="java.lang.String"/>
	<parameter name="branch" class="java.lang.String"/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT bl_no,job_number,income,expense,(income-expense) profitloss
                FROM (SELECT SUM(je.accounted_dr) income,SUM(je.accounted_cr) expense,
                je.bl_no,bl.job_number
                FROM gl_je_f je
                LEFT OUTER JOIN bl_hdr_f bl ON (bl.bl_no = je.bl_no)
                LEFT OUTER JOIN ar_customer_trx_f trx ON (trx.awb_bl_no = je.bl_no
		AND je.je_source_hdr_id = trx.customer_trx_id)
                WHERE (je.bl_no IS NOT NULL AND je.bl_no <> '0' AND je.bl_no <> '')
                AND (je.hdr_line_flag = 'H' OR je.je_source = 'JOURNAL')
		AND je.bl_no LIKE $P{blNo} AND (bl.job_number LIKE $P{jobNo})
		AND trx.sea_air LIKE $P{seaAir} AND trx.exp_imp LIKE $P{exportImport}
		AND (sales_by LIKE $P{salesMan} OR rev_exp = 'EXPENSE')
		AND (trx.loading_agnt LIKE $P{branch} OR je.attribute2 LIKE $P{branch})
		AND je.je_date BETWEEN $P{startDate} AND $P{endDate}
                GROUP BY je.bl_no,bl.job_number) SUMMARY]]>
	</queryString>
	<field name="bl_no" class="java.lang.String"/>
	<field name="job_number" class="java.lang.String"/>
	<field name="income" class="java.math.BigDecimal"/>
	<field name="expense" class="java.math.BigDecimal"/>
	<field name="profitloss" class="java.math.BigDecimal"/>
	<variable name="TOTAL_INCOME" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{income}]]></variableExpression>
	</variable>
	<variable name="TOTAL_EXPENSE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{expense}]]></variableExpression>
	</variable>
	<variable name="NET_PROFIT_LOSS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{profitloss}]]></variableExpression>
	</variable>
	<variable name="JOB_INCOME" class="java.math.BigDecimal" resetType="Group" resetGroup="JOBWISE" calculation="Sum">
		<variableExpression><![CDATA[$F{income}]]></variableExpression>
	</variable>
	<variable name="JOB_EXPENSE" class="java.math.BigDecimal" resetType="Group" resetGroup="JOBWISE" calculation="Sum">
		<variableExpression><![CDATA[$F{expense}]]></variableExpression>
	</variable>
	<variable name="JOB_PROFIT_LOSS" class="java.math.BigDecimal" resetType="Group" resetGroup="JOBWISE" calculation="Sum">
		<variableExpression><![CDATA[$F{profitloss}]]></variableExpression>
	</variable>
	<group name="JOBWISE">
		<groupExpression><![CDATA[$F{job_number}]]></groupExpression>
		<groupHeader>
			<band height="20">
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="0" width="71" height="14"/>
					<textElement>
						<font fontName="Arial" size="11" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{job_number}]]></textFieldExpression>
				</textField>
				<line>
					<reportElement x="0" y="17" width="555" height="1"/>
				</line>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18">
				<textField>
					<reportElement x="307" y="1" width="73" height="15">
						<printWhenExpression><![CDATA[$F{job_number} != null && !$F{job_number}.equals("")]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Right">
						<font fontName="Arial" size="9" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{JOB_INCOME}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="386" y="1" width="71" height="15">
						<printWhenExpression><![CDATA[$F{job_number} != null && !$F{job_number}.equals("")]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Right">
						<font fontName="Arial" size="9" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{JOB_EXPENSE}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="463" y="1" width="91" height="15">
						<printWhenExpression><![CDATA[$F{job_number} != null && !$F{job_number}.equals("")]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Right">
						<font fontName="Arial" size="9" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{JOB_PROFIT_LOSS}]]></textFieldExpression>
				</textField>
				<line>
					<reportElement x="0" y="17" width="555" height="1"/>
				</line>
				<line>
					<reportElement x="0" y="15" width="555" height="1"/>
				</line>
			</band>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
