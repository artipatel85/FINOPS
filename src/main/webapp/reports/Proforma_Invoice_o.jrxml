	<parameter name="SHIP_TOLERANCE_BELOW" isForPrompting="false" class="java.lang.String"/>
	<parameter name="PACKING_INSTRUCTION" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COO_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COFD_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="POD_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="POFD_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="POLD_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="TOTAL" isForPrompting="false" class="java.lang.String"/>
	<parameter name="PI_VALUE" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="DISCOUNT" isForPrompting="false" class="java.lang.String"/>
	<parameter name="UOM_DESC" isForPrompting="false" class="java.lang.String"/>
	<parameter name="REMARK" isForPrompting="false" class="java.lang.String"/>
	<parameter name="CNF_FOB" isForPrompting="false" class="java.lang.String"/>
	<parameter name="cnf" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT  PI_LINE.pi_line_id , XREF.PARTY_ITEM_DESC
	     ,XREF.ITEM_SIZE
	 
     ,CAST(SUM(PI_LINE.PI_QTY)AS DECIMAL(15,2)) AS QTY_PCS                                  
	                                 
	,CAST(AVG(PI_LINE.ITEM_RATE) AS DECIMAL(15,2))AS ITEM_RATE
   
          ,CAST(SUM(PI_LINE.PI_QTY) * AVG(PI_LINE.ITEM_RATE) AS DECIMAL(15,2))AS  AMOUNT
     
           ,PI_HDR.UOM_CONTAINER 
            ,UOM.UOM_SYMBOL  UOM_SYMBOL          
              ,PI_HDR.REMARK                             
   
         FROM OM_PI_HDR_F PI_HDR                                   
	      
          INNER JOIN OM_PI_LINE_F PI_LINE
	       ON (PI_HDR.PI_HDR_ID = PI_LINE.PI_HDR_ID ) 
           INNER JOIN OM_ORDER_LINE_F OM_LINE
	      ON(PI_LINE.ORDER_LINE_ID = OM_LINE.ORDER_LINE_ID)                                  
	       LEFT OUTER JOIN MTL_XREF_D XREF                                      
   	        ON (PI_LINE.INVENTORY_ITEM_ID = XREF.INVENTORY_ITEM_ID	
            AND PI_HDR.CUSTOMER_ID = XREF.PARTY_ID) 
            INNER JOIN MTL_INVENTORY_ITEM_D INV
             ON (PI_LINE.INVENTORY_ITEM_ID = INV.INVENTORY_ITEM_ID)
	        LEFT OUTER JOIN UOM_D UOM                                      
   	         ON (PI_LINE.UOM_ID = UOM.UOM_ID)	
 
WHERE PI_LINE.PI_HDR_ID =$P{PI_HDR_ID}
	
GROUP BY PI_LINE.pi_line_id, XREF.PARTY_ITEM_DESC 
       ,XREF.ITEM_SIZE
       ,PI_HDR.UOM_CONTAINER             
        ,PI_HDR.REMARK                             
        ,UOM.UOM_SYMBOL]]></queryString>

