	<queryString>
		<![CDATA[select dist.bill_distribution_id
                ,dist.bill_distribution_sno
                ,dist.code_combination_id
                ,dist.bill_entry_hdr_id


                ,dist.expense_flag

,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(cc.acct_name as varchar) END AS acct_name
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.distribution_amount as varchar) END AS distribution_amount
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.dr_cr_flag as varchar) END AS dr_cr_flag
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.tax_percent as varchar) END AS tax_percent
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE '%' END AS symbol
from ap_bill_distribution_f dist
                 inner join gl_code_combination_d cc
                 on(dist.code_combination_id=cc.code_combination_id)
                  where dist.bill_entry_hdr_id=$P{bill_entry_hdr_id} and dist.expense_flag  in('L')]]>
	</queryString>
