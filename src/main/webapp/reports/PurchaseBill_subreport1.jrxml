		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="535"
		 pageHeight="802"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="bill_entry_hdr_id" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select dist.bill_distribution_id
                ,dist.bill_distribution_sno
                ,dist.code_combination_id
                ,dist.bill_entry_hdr_id
                
                
                ,dist.expense_flag 

,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(cc.acct_name as varchar) END AS acct_name1
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.distribution_amount as varchar) END AS distribution_amount1
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.dr_cr_flag as varchar) END AS dr_cr_flag1
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE cast(dist.tax_percent as varchar) END AS tax_percent1 
,CASE WHEN cast(dist.distribution_amount as varchar)='0.00' THEN  '' ELSE '%' END AS symbol1                               

from ap_bill_distribution_f dist
                 left outer join gl_code_combination_d cc 
                 on(dist.code_combination_id=cc.code_combination_id) where dist.expense_flag in ('E')
and dist.bill_entry_hdr_id=$P{bill_entry_hdr_id}]]></queryString>

	<field name="symbol1" class="java.lang.String"/>
	<field name="tax_percent1" class="java.lang.String"/>
	<field name="dr_cr_flag1" class="java.lang.String"/>
	<field name="distribution_amount1" class="java.lang.String"/>
	<field name="acct_name1" class="java.lang.String"/>

