<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="Purchase_Order_gpo"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="700"
		 pageHeight="842"
		 columnWidth="700"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<style 
		name="Shaded"
		isDefault="false"
		backcolor="#666666"
	/>
	<style 
		name="LightShaded"
		isDefault="true"
		backcolor="#CCCCCC"
	/>

	<parameter name="FMO_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FMO_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FMO_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TODAY" isForPrompting="true" class="java.lang.String"/>
	<parameter name="MATERIAL_REQD_IF_ANY" isForPrompting="true" class="java.lang.String"/>
	<parameter name="BILL_TO_CC_NAME" isForPrompting="true" class="java.lang.String"/>
	<parameter name="SHIP_TO_CC_NAME" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CRATE_MARKING_COLOR" isForPrompting="true" class="java.lang.String"/>
	<parameter name="SHIP_TOLERANCE_ABOVE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="SHIP_TOLERANCE_BELOW" isForPrompting="false" class="java.lang.String"/>
	<parameter name="NOTE_TO_SUPPLIER" isForPrompting="false" class="java.lang.String"/>
	<parameter name="PACKING_INSTRUCTIONS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="QUALITY_INSTRUCTIONS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="VEND_TO_CC" isForPrompting="false" class="java.lang.String"/>
	<parameter name="VENDOR_TO_CC" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FIELD_REP" isForPrompting="false" class="java.lang.String"/>
	<parameter name="ORDER_BOOKED_DATE" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT case when inv_item.item_class_id in (1001,1002,1003) then
      (ltrim(rtrim(mtl_type_d.PRD_TYPE_DESC))+' '+
       ltrim(rtrim(mtl_modality_d.MODALITY_DESC))+' '+
       ltrim(rtrim(mtl_category_d.CATEGORY_DESC))+' '+
       ltrim(rtrim(mtl_color_d.COLOR_DESC))) 
       else inv_item.item_desc
       end item_desc
      ,case when inv_item.item_class_id in (1001,1002,1003) then
       ltrim(rtrim(INV_ITEM.LENGTH))+' X '+
       ltrim(rtrim(INV_ITEM.BREADTH))+' X '+
       ltrim(rtrim(INV_ITEM.THICKNESS)) 
       end item_size          
       
      ,CAST(SUM(PO_LINE.MO_QTY)AS DECIMAL(15,2)) AS QTY_PCS              
      ,CAST(AVG(PO_LINE.MO_RATE) AS DECIMAL(15,2))AS FMO_RATE          
      ,CAST(SUM(PO_LINE.MO_QTY)*AVG(PO_LINE.MO_RATE)  AS DECIMAL(15,2)) AS AMOUNT                         
       ,PO_HDR.FMO_NUMBER CUST_PO_NUMBER
       ,PO_HDR.FMO_DATE CUST_PO_DATE  
 ,TRX_UOM.UOM_SYMBOL                                  
                                   
                                  
                                FROM FMO_LINE_F PO_LINE
                                    INNER JOIN FMO_HDR_F PO_HDR
                                        ON (PO_HDR.FMO_HDR_ID = PO_LINE.FMO_HDR_ID)
                                    INNER JOIN MTL_INVENTORY_ITEM_D INV_ITEM
                                        ON (PO_LINE.INVENTORY_ITEM_ID = INV_ITEM.INVENTORY_ITEM_ID)
                                                                             
                                    LEFT OUTER JOIN mtl_type_d mtl_type_d
                                        ON(INV_ITEM.PRD_TYPE_ID =mtl_type_d.PRD_TYPE_ID)
                                          LEFT OUTER JOIN mtl_modality_d mtl_modality_d
                                        ON(INV_ITEM.MODALITY_ID=mtl_modality_d.MODALITY_ID)
                                            LEFT OUTER JOIN mtl_category_d mtl_category_d
                                        ON(INV_ITEM.CATEGORY_ID=mtl_category_d.CATEGORY_ID) 
                                            LEFT OUTER JOIN mtl_color_d mtl_color_d
                                           ON(INV_ITEM.COLOR_ID=mtl_color_d.COLOR_ID)
                                   LEFT OUTER JOIN UOM_D TRX_UOM                                      
   ON (PO_LINE.UOM_ID = TRX_UOM.UOM_ID)	
                                   WHERE PO_LINE.FMO_HDR_ID=$P{FMO_HDR_ID}
GROUP BY

inv_item.item_class_id
,mtl_type_d.PRD_TYPE_DESC
,mtl_modality_d.MODALITY_DESC
,mtl_category_d.CATEGORY_DESC
,mtl_color_d.COLOR_DESC
,item_desc
 ,INV_ITEM.LENGTH
 ,INV_ITEM.BREADTH    
 ,INV_ITEM.THICKNESS   
   ,PO_HDR.FMO_NUMBER 
  ,PO_HDR.FMO_DATE 
 ,TRX_UOM.UOM_SYMBOL]]></queryString>

	<field name="ITEM_SIZE" class="java.lang.String"/>
	<field name="ITEM_DESC" class="java.lang.String"/>
	<field name="QTY_PCS" class="java.lang.Integer"/>
	<field name="FMO_RATE" class="java.lang.Float"/>
	<field name="CUST_PO_DATE" class="java.lang.String"/>
	<field name="AMOUNT" class="java.lang.Float"/>
	<field name="UOM_SYMBOL" class="java.lang.String"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{AMOUNT}.floatValue())]]></variableExpression>
	</variable>

