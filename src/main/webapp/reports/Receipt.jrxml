	<parameter name="acct_name" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT je.je_hdr_id
      ,combination.acct_name 
     ,   je.entered_dr
      ,je.chq_no
     ,UPPER(CONVERT(CHAR(12),je.chq_date ,106)) chq_date
     ,je.je_line_remarks
      FROM gl_je_f je
left outer join gl_code_combination_d combination
on(combination.CODE_COMBINATION_ID =je.cash_bank)
 WHERE je.je_hdr_id = $P{je_hdr_id}]]></queryString>

