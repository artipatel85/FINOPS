<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Bank_rec" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="2"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="26"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="companyId" class="java.lang.Integer"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="lineAcctId" class="java.lang.Integer"/>
	<parameter name="endDate" class="java.lang.String"/>
	<parameter name="curBalance" class="java.math.BigDecimal"/>
	<parameter name="drCr" class="java.lang.String"/>
	<parameter name="flagQuery" class="java.lang.String"/>
	<parameter name="acctName" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  CONVERT(CHAR(10),je.je_date,120)je_date,cc1.acct_name ,cc2.acct_name CACCT,
        je.je_voucher_no, je.je_source,
        je.accounted_cr accounted_dr,je.accounted_dr accounted_cr,je.je_hdr_id,je.je_line_id,je.attribute8,
        je.je_source_hdr_id,je.je_line_remarks,je.chq_no,CONVERT(char(10),je.chq_date,120) chq_date,
        (CAST(je.je_hdr_id as VARCHAR) + CAST(je.je_line_id as VARCHAR)) reconcilecheck,
        reconcile_date
        FROM gl_je_f je
        LEFT OUTER JOIN gl_code_combination_d cc1 on(je.cash_bank=cc1.code_combination_id)
	LEFT OUTER JOIN gl_code_combination_d cc2 on (je.code_combination_id=cc2.code_combination_id)
        WHERE je.COMPANY_ID=$P{companyId} AND je.acct_year=$P{acctYear}
	AND je.cash_bank =$P{lineAcctId} AND reconcile_date IS NULL
        AND je.je_date <= CAST($P{endDate} AS DATETIME)

UNION ALL

select vrdt JE_DATE,BANK_ACCT_NAME ACCT_NAME,acct_name CACCT,VRNO je_voucher_no,'DOCFA' je_source,
(CASE WHEN DC='C' THEN AMT ELSE 000 END) accounted_dr,
(CASE WHEN DC='D' THEN AMT ELSE 000 END) accounted_cr,
RECONID je_hdr_id,'' je_line_id,NULL attribute8,NULL je_source_hdr_id,NARR1 je_line_remarks,NULL chq_no,NULL chq_date,RECONID reconcilecheck,
RECONDT reconcile_date
from DOCFA_RECON
where BANK_CODE = (SELECT ACCT_CODE FROM gl_code_combination_d where CODE_COMBINATION_ID=$P{lineAcctId})
and recondt is null
AND VRDT <= CAST($P{endDate} AS DATETIME)]]>
	</queryString>
	<field name="je_date" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="CACCT" class="java.lang.String"/>
	<field name="je_voucher_no" class="java.lang.String"/>
	<field name="je_source" class="java.lang.String"/>
	<field name="accounted_dr" class="java.math.BigDecimal"/>
	<field name="accounted_cr" class="java.math.BigDecimal"/>
	<field name="je_hdr_id" class="java.lang.Integer"/>
	<field name="je_line_id" class="java.lang.Integer"/>
	<field name="attribute8" class="java.sql.Timestamp"/>
	<field name="je_source_hdr_id" class="java.lang.Integer"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<field name="chq_no" class="java.lang.String"/>
	<field name="chq_date" class="java.lang.String"/>
	<field name="reconcilecheck" class="java.lang.Integer"/>
	<field name="reconcile_date" class="java.lang.String"/>
	<variable name="PAGE_TOTAL" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{accounted_dr}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal(0.00)]]></initialValueExpression>
	</variable>
	<variable name="PAGE_TOTAL_CR" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{accounted_cr}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal(0.00)]]></initialValueExpression>
	</variable>
	<variable name="bankBalance" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{PAGE_TOTAL}.subtract($V{PAGE_TOTAL_CR}).subtract($P{curBalance})]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="DR_CR" class="java.lang.String">
		<variableExpression><![CDATA[$V{bankBalance}.doubleValue() < 0 ? "CR" : "DR"]]></variableExpression>
	</variable>
