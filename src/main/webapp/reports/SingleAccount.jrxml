	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="companyId" class="java.lang.String"/>
	<parameter name="sumDebit" class="java.lang.String" isForPrompting="false"/>
	<parameter name="sumCredit" class="java.lang.String" isForPrompting="false"/>
	<parameter name="ADDRESS" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Company" class="java.lang.String" isForPrompting="false"/>
	<parameter name="COMPANY_ID" class="java.lang.String"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="finYrStart" class="java.lang.String" isForPrompting="false"/>
	<parameter name="finYrEnd" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromDate" class="java.lang.String" isForPrompting="false"/>
	<parameter name="toDate" class="java.lang.String" isForPrompting="false"/>
	<parameter name="codecomb" class="java.lang.Integer"/>
	<parameter name="ACCT_NAME" class="java.lang.String" isForPrompting="false"/>
	<parameter name="dayMonth" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CC.ACCT_NAME,cc.acct_flag ,_31_3 cur_bal,bal._0_0 opn_bal,
CASE WHEN cc.acct_flag = 'G' THEN CC.ACCT_ID ELSE cc.parent_id  END as id,
CC.CODE_COMBINATION_ID ,CASE WHEN _31_3 >= 0 THEN COALESCE(_31_3,0) ELSE 0.00 END debit,
CASE WHEN _31_3 < 0 THEN ABS(COALESCE(_31_3,0)) ELSE 0.00 END credit,
cc.parent_id ,cc.acct_id
FROM (SELECT * FROM GL_CODE_COMBINATION_D
WHERE COMPANY_ID=$P{companyId}) CC
INNER JOIN gl_day_balances_f bal ON (bal.CODE_COMBINATION_ID=cc.CODE_COMBINATION_ID)
WHERE cc.company_id=$P{companyId} AND bal.acct_year=$P{acctYear} AND cc.acct_flag ='L'
ORDER BY cc.acct_name,cc.acct_flag]]>
	</queryString>
	<field name="ACCT_NAME" class="java.lang.String"/>
	<field name="acct_flag" class="java.lang.String"/>
	<field name="cur_bal" class="java.math.BigDecimal"/>
	<field name="opn_bal" class="java.math.BigDecimal"/>
	<field name="id" class="java.lang.Integer"/>
	<field name="CODE_COMBINATION_ID" class="java.lang.Integer"/>
	<field name="debit" class="java.math.BigDecimal"/>
	<field name="credit" class="java.math.BigDecimal"/>
	<field name="parent_id" class="java.lang.Integer"/>
	<field name="acct_id" class="java.lang.Integer"/>
	<variable name="SUM_DEBIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{debit}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_CREDIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{credit}.doubleValue())]]></variableExpression>
	</variable>
