	<variable name="SUM_conv_qty_1" class="java.lang.Double" resetType="Group" resetGroup="Item_Group" calculation="Sum">
		<variableExpression><![CDATA[Double.valueOf((($F{issue_receipt}.equals("R")&&$F{conv_qty}!= null) ? $F{conv_qty} : new Double(0)).doubleValue()+($V{opn_qty} == null ? 0.000 : $V{opn_qty}.doubleValue()))]]></variableExpression>
	</variable>
	<variable name="SUM_conv_qty_2" class="java.lang.Double" resetType="Group" resetGroup="Item_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_receipt}.equals("I") ? $F{conv_qty} : new Double(0)]]></variableExpression>
	</variable>
	<variable name="SUM_opn_qty_1" class="java.lang.Double" resetType="Group" resetGroup="Item_Group" calculation="Nothing">
		<variableExpression><![CDATA[Double.valueOf($V{SUM_conv_qty_1}.doubleValue()-$V{SUM_conv_qty_2}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[Double.valueOf(0)]]></initialValueExpression>
	</variable>
	<variable name="opn_qty" class="java.lang.Double" resetType="Report" calculation="Nothing">
	</variable>
	<variable name="Qty_PCS_R" class="java.lang.String" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[$F{issue_receipt}.equals("R")?new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{uom_id}.toString(),$F{length},$F{breadth},$F{height},$F{trx_qty}.doubleValue()):""]]></variableExpression>
	</variable>
	<variable name="Qty_PCS_I" class="java.lang.String" resetType="None" calculation="Nothing">
		<variableExpression><![CDATA[$F{issue_receipt}.equals("I")?new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{uom_id}.toString(),$F{length},$F{breadth},$F{height},$F{trx_qty}.doubleValue()):""]]></variableExpression>
	</variable>
	<variable name="Total_Qty_PCS_R" class="java.lang.String" resetType="None" calculation="Sum">
		<variableExpression><![CDATA[new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{uomd_id}.toString(),$F{length},$F{breadth},$F{height},$V{SUM_conv_qty_1}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="Total_Qty_PCS_I" class="java.lang.String" resetType="None" calculation="Sum">
		<variableExpression><![CDATA[new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{uomd_id}.toString(),$F{length},$F{breadth},$F{height},$V{SUM_conv_qty_2}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="Total_Closing_PCS" class="java.lang.Integer" resetType="Group" resetGroup="Item_Group" calculation="Nothing">
		<variableExpression><![CDATA[new Integer(Integer.parseInt($V{Total_Qty_PCS_R}) - Integer.parseInt($V{Total_Qty_PCS_I}))]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>

