<jasperReport
		 name="Stock_Register"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="992"
		 pageHeight="595"
		 columnWidth="932"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="itemDesc" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="tDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="fCC" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="tCC" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="fIC" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="tIC" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="openingBalance" isForPrompting="false" class="java.util.HashMap"/>
	<parameter name="companyId" isForPrompting="true" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[".\\"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT * FROM 
(SELECT trx.trx_id,CONVERT(CHAR(10),trx.trx_date,120) trx_date,trx.trx_no,
		trx.trx_type,trx.from_cc_id,trx.from_vendor_id,trx.to_cc_id,
		trx.category_id,trx.truck_number,trx.bill_no,
		CONVERT(CHAR(10),trx.bill_date,120) bill_date,
		trx.inventory_item_id,trx.uom_id,trx.issue_receipt,trx.trx_qty,
		trx.conv_qty,trx.cc_id,trx.company_id,cc.cc_name,
		item.item_class_id, item.item_code, item.item_desc,
		item.length,item.breadth,item.height,
		class.item_class_desc,uom.uom_desc,uomd.uom_desc uomd_desc,
		company.company_name,trx.description,item.uom_id uomd_id
	FROM mtl_stock_s trx
	LEFT OUTER JOIN cost_center_d cc ON (trx.cc_id = cc.cc_id)
	LEFT OUTER JOIN uom_d uomd ON (trx.uom_id = uomd.uom_id)
	LEFT OUTER JOIN mtl_inventory_item_d item ON (trx.inventory_item_id = item.inventory_item_id)
	LEFT OUTER JOIN mtl_item_class_d class ON (item.item_class_id = class.item_class_id)
	LEFT OUTER JOIN uom_d uom ON (item.uom_id = uom.uom_id)
	LEFT OUTER JOIN company_d company ON (trx.company_id = company.company_id)
	
	WHERE trx.company_id = $P{companyId} 
	AND trx.trx_type <> 'OPN'
        AND item.item_desc like ('%'+$P{itemDesc}+'%')
	AND cc.cc_id BETWEEN $P{fCC} AND $P{tCC}
	AND class.item_class_id BETWEEN $P{fIC} AND $P{tIC}
	AND trx.trx_date BETWEEN $P{fDate} AND $P{tDate}
	
UNION

	SELECT trx.trx_id,'' trx_date,'' trx_no,
		'' trx_type,0 from_cc_id,0 from_vendor_id,0 to_cc_id,
		trx.category_id,'' truck_number,'' bill_no,
		'' bill_date,
		trx.inventory_item_id,trx.uom_id,trx.issue_receipt,null trx_qty,
		null conv_qty,trx.cc_id,trx.company_id,cc.cc_name,
		item.item_class_id, item.item_code, item.item_desc,
		item.length,item.breadth,item.height,
		class.item_class_desc,uom.uom_desc uom_desc,'' uomd_desc,
		company.company_name,'' description,item.uom_id uomd_id
	FROM mtl_stock_s trx
	LEFT OUTER JOIN cost_center_d cc ON (trx.cc_id = cc.cc_id)
	LEFT OUTER JOIN uom_d uomd ON (trx.uom_id = uomd.uom_id)
	LEFT OUTER JOIN mtl_inventory_item_d item ON (trx.inventory_item_id = item.inventory_item_id)
	LEFT OUTER JOIN mtl_item_class_d class ON (item.item_class_id = class.item_class_id)
	LEFT OUTER JOIN uom_d uom ON (item.uom_id = uom.uom_id)
	LEFT OUTER JOIN company_d company ON (trx.company_id = company.company_id)
	
	WHERE trx.company_id = $P{companyId} 
	AND trx.trx_type = 'OPN'
        AND item.item_desc like ('%'+$P{itemDesc}+'%')
	AND cc.cc_id BETWEEN $P{fCC} AND $P{tCC}
	AND class.item_class_id BETWEEN $P{fIC} AND $P{tIC}
	AND trx.trx_date < $P{fDate}
	) A

ORDER BY  A.cc_name,A.item_class_id,A.item_code,A.trx_date]]></queryString>

