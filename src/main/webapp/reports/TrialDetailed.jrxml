				<reportElement x="486" y="0" width="69" height="15">
					<printWhenExpression><![CDATA[$P{openOnly}.equals("false")]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CLOSING]]></text>
