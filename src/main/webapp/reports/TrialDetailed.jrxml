<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TrialDetailed" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="companyId" class="java.lang.Integer"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="endField" class="java.lang.String"/>
	<parameter name="openOnly" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT cc.acct_name,cc.acct_flag,_31_3 cur_bal,bal._0_0 opn_bal,cc.parent_id,
                cc.code_combination_id,CASE WHEN _31_3 >= 0 THEN COALESCE(_31_3,0) ELSE 0.00 END debit,
                CASE WHEN _31_3 < 0 THEN COALESCE(_31_3,0) ELSE 0.00 END credit,cc.parent_id
                FROM gl_code_combination_d cc
                INNER JOIN gl_day_balances_f bal ON (bal.code_combination_id=cc.code_combination_id)
                WHERE bal.acct_year=$P{acctYear} AND cc.acct_flag='L' AND cc.parent_id IN (22)
                AND cc.company_id=$P{companyId}
		ORDER BY cc.acct_name]]>
	</queryString>
	<field name="opnBal" class="java.math.BigDecimal"/>
	<field name="lineDebit" class="java.math.BigDecimal"/>
	<field name="lineCredit" class="java.math.BigDecimal"/>
	<field name="lineParticulars" class="java.lang.String"/>
	<variable name="CLOSING_BAL" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{lineDebit}.add($F{lineCredit})]]></variableExpression>
	</variable>
	<variable name="TOTAL_OPEN" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{opnBal}]]></variableExpression>
	</variable>
	<variable name="TOTAL_CLOSE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{CLOSING_BAL}]]></variableExpression>
	</variable>
	<variable name="TOTAL_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{ACT_DEBIT}]]></variableExpression>
	</variable>
	<variable name="TOTAL_CREDIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{ACT_CREDIT}]]></variableExpression>
	</variable>
	<variable name="ACT_DEBIT" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($F{lineDebit}.doubleValue() > 0) ? $F{lineDebit}.subtract($F{opnBal}) : $F{lineDebit}]]></variableExpression>
	</variable>
	<variable name="ACT_CREDIT" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($F{lineCredit}.doubleValue() < 0) ? $F{lineCredit}.subtract($F{opnBal}).negate() : $F{lineCredit}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="69" splitType="Stretch">
			<textField>
				<reportElement x="3" y="23" width="211" height="43"/>
