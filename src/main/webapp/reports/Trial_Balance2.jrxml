	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="companyId" isForPrompting="false" class="java.lang.Integer"/>
	<parameter name="sumDebit" isForPrompting="false" class="java.lang.String"/>
	<parameter name="sumCredit" isForPrompting="false" class="java.lang.String"/>
	<parameter name="ADDRESS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="Company" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_ID" isForPrompting="false" class="java.lang.String"/>
	<parameter name="acctYear" isForPrompting="false" class="java.lang.String"/>
	<parameter name="finYrStart" isForPrompting="false" class="java.lang.String"/>
	<parameter name="finYrEnd" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fromDate" isForPrompting="false" class="java.lang.String"/>
	<parameter name="toDate" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT CC.ACCT_NAME,cc.acct_flag ,bal.cur_bal
,CASE WHEN cc.acct_flag = 'G'  THEN CC.ACCT_ID   ELSE cc.parent_id  END as id  
 ,CC.CODE_COMBINATION_ID 
,case when bal.cur_bal>=0   then coalesce(bal.cur_bal,0) else 0.00 end debit 
,case when bal.cur_bal<0  then abs(coalesce(bal.cur_bal,0)) else 0.00 end credit 
,cc.parent_id ,cc.acct_id   
FROM (SELECT * FROM GL_CODE_COMBINATION_D  
WHERE COMPANY_ID=$P{COMPANY_ID}) CC    
INNER JOIN gl_balances_f bal   ON (bal.CODE_COMBINATION_ID=cc.CODE_COMBINATION_ID) 
WHERE cc.company_id=$P{COMPANY_ID}   
AND bal.acct_year=$P{acctYear}  
AND cc.acct_flag ='L' and (cc.parent_id <>0 and cc.acct_id <>16) 
and(bal.cur_bal<>0 ) 
ORDER BY cc.acct_id,cc.acct_flag]]></queryString>

	<field name="debit" class="java.lang.Double"/>
	<field name="credit" class="java.lang.Double"/>
	<field name="ACCT_NAME" class="java.lang.String"/>

	<variable name="SUM_DEBIT" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{debit}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_CREDIT" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{credit}.doubleValue())]]></variableExpression>
	</variable>
