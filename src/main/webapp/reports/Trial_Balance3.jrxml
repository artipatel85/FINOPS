	<parameter name="sumDebit" class="java.lang.String" isForPrompting="false"/>
	<parameter name="sumCredit" class="java.lang.String" isForPrompting="false"/>
	<parameter name="ADDRESS" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Company" class="java.lang.String" isForPrompting="false"/>
	<parameter name="COMPANY_ID" class="java.lang.String"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="finYrStart" class="java.lang.String" isForPrompting="false"/>
	<parameter name="finYrEnd" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fromDate" class="java.lang.String" isForPrompting="false"/>
	<parameter name="toDate" class="java.lang.String" isForPrompting="false"/>
	<parameter name="codecomb" class="java.lang.Integer"/>
	<parameter name="acctName" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT CC.ACCT_NAME,cc.acct_flag ,bal.cur_bal,bal.opn_bal,CASE WHEN cc.acct_flag = 'G'
 THEN CC.ACCT_ID   ELSE cc.parent_id  END as id   ,CC.CODE_COMBINATION_ID
,case when bal.cur_bal>=0   then coalesce(bal.cur_bal,0) else 0.00 end debit
,case when bal.cur_bal<0  then abs(coalesce(bal.cur_bal,0)) else 0.00 end credit
 ,cc.parent_id ,cc.acct_id
  FROM (SELECT * FROM GL_CODE_COMBINATION_D  WHERE COMPANY_ID=$P{COMPANY_ID}) CC
  INNER JOIN gl_balances_f bal   ON (bal.CODE_COMBINATION_ID=cc.CODE_COMBINATION_ID)
 WHERE cc.company_id=$P{COMPANY_ID}   AND bal.acct_year=$P{acctYear}
 and cc.parent_id =$P{codecomb} ORDER BY cc.ACCT_NAME]]>
	</queryString>
	<field name="debit" class="java.lang.Double"/>
	<field name="credit" class="java.lang.Double"/>
	<field name="ACCT_NAME" class="java.lang.String"/>
	<variable name="SUM_DEBIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{debit}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_CREDIT" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{credit}.doubleValue())]]></variableExpression>
	</variable>
