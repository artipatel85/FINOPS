<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Turnover" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="localForeign" class="java.lang.String"/>
	<parameter name="seaAir" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CONVERT(CHAR(10),trx_date,120) trx_date,ar.customer_trx_id,trx_number,trx_total,total_tax,ofr.amount ofr,
hcr.amount hcr,ar.partner_account_code,pa.DESCRIPTION1,thc.amount thc,trs.amount trs
FROM ar_customer_trx_f ar
LEFT OUTER JOIN (SELECT SUM(ACCOUNTED_AMOUNT) amount,CODE_COMBINATION_ID,CUSTOMER_TRX_ID
FROM ar_customer_trx_lines_f
GROUP BY CODE_COMBINATION_ID,CUSTOMER_TRX_ID
HAVING code_combination_id IN (1048)) ofr ON (ofr.CUSTOMER_TRX_ID=ar.CUSTOMER_TRX_ID)
LEFT OUTER JOIN (SELECT SUM(ACCOUNTED_AMOUNT) amount,CODE_COMBINATION_ID,CUSTOMER_TRX_ID
FROM ar_customer_trx_lines_f
GROUP BY CODE_COMBINATION_ID,CUSTOMER_TRX_ID
HAVING code_combination_id IN (1052)) hcr ON (hcr.CUSTOMER_TRX_ID=ar.CUSTOMER_TRX_ID)
LEFT OUTER JOIN (SELECT SUM(ACCOUNTED_AMOUNT) amount,CODE_COMBINATION_ID,CUSTOMER_TRX_ID
FROM ar_customer_trx_lines_f
GROUP BY CODE_COMBINATION_ID,CUSTOMER_TRX_ID
HAVING code_combination_id IN (1051)) thc ON (thc.CUSTOMER_TRX_ID=ar.CUSTOMER_TRX_ID)
LEFT OUTER JOIN (SELECT SUM(ACCOUNTED_AMOUNT) amount,CODE_COMBINATION_ID,CUSTOMER_TRX_ID
FROM ar_customer_trx_lines_f
GROUP BY CODE_COMBINATION_ID,CUSTOMER_TRX_ID
HAVING code_combination_id IN (1054)) trs ON (trs.CUSTOMER_TRX_ID=ar.CUSTOMER_TRX_ID)
LEFT OUTER JOIN partner_account_d pa ON (ar.BILLTO = pa.PARTNER_CODE
AND pa.LOADNG_AGNT = ar.LOADING_AGNT)
WHERE ar.trx_date BETWEEN $P{startDate} AND $P{endDate}
AND ar.REV_EXP = 'REVENUE' AND ar.LOCAL_FOREIGN LIKE $P{localForeign} AND ar.SEA_AIR LIKE $P{seaAir}]]>
	</queryString>
	<field name="trx_date" class="java.lang.String"/>
	<field name="customer_trx_id" class="java.lang.Integer"/>
	<field name="trx_number" class="java.lang.String"/>
	<field name="trx_total" class="java.math.BigDecimal"/>
	<field name="total_tax" class="java.math.BigDecimal"/>
	<field name="ofr" class="java.math.BigDecimal"/>
	<field name="hcr" class="java.math.BigDecimal"/>
	<field name="partner_account_code" class="java.lang.Integer"/>
	<field name="DESCRIPTION1" class="java.lang.String"/>
	<field name="thc" class="java.math.BigDecimal"/>
	<field name="trs" class="java.math.BigDecimal"/>
	<variable name="TOTAL_BILL_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{trx_total}]]></variableExpression>
	</variable>
	<variable name="TOTAL_HCR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{hcr}]]></variableExpression>
	</variable>
	<variable name="TOTAL_THC" class="java.math.BigDecimal" calculation="Sum">
