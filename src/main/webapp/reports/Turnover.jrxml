	</variable>
	<variable name="TOTAL_OFR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ofr}]]></variableExpression>
	</variable>
	<variable name="TOTAL_STAX" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_tax}]]></variableExpression>
	</variable>
	<variable name="TOTAL_TRS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{trs}]]></variableExpression>
	</variable>
