<jasperReport
		 name="VEN_UNLoading_Details_o"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="700"
		 pageHeight="842"
		 columnWidth="700"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<style 
		name="Shaded"
		isDefault="false"
		backcolor="#666666"
	/>
	<style 
		name="LightShaded"
		isDefault="true"
		backcolor="#CCCCCC"
	/>

	<parameter name="ULD_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ULD_SNO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="LD_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ULD_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="LD_SNO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TRUCK_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TOTAL_WT" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FREIGHT_RATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TOTAL_FREIGHT" isForPrompting="true" class="java.lang.String"/>
	<parameter name="LOADING_CHARGES" isForPrompting="false" class="java.lang.String"/>
	<parameter name="OTHER_CHARGES" isForPrompting="false" class="java.lang.String"/>
	<parameter name="LD_STAFF" isForPrompting="false" class="java.lang.String"/>
	<parameter name="TO_CC_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="USER_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="TO_ADDRESS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FROM_CC_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="FROM_ADDRESS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="LD_HDR_REMARKS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="BILL_NO" isForPrompting="false" class="java.lang.String"/>
	<parameter name="BILL_DATE" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="VENDOR_NAME" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT  case when INV_ITEM.item_class_id in (1001,1002,1003) then
(RTRIM(LTRIM(mtl_color_d.COLOR_DESC))+ ' '+
        RTRIM(LTRIM(mtl_type_d.PRD_TYPE_DESC))+' '+
        RTRIM(LTRIM(mtl_category_d.CATEGORY_DESC))+' '+
       RTRIM(LTRIM(mtl_modality_d.MODALITY_DESC))) 
     else inv_item.item_desc
       end item_desc
      ,coalesce(case when inv_item.item_class_id in (1001,1002,1003) then
       ltrim(rtrim(INV_ITEM.LENGTH))+' '+ltrim(rtrim(L_UOM.UOM_SYMBOL))+' X '+
       ltrim(rtrim(INV_ITEM.BREADTH))+' '+ltrim(rtrim(B_UOM.UOM_SYMBOL))+' X '+
       ltrim(rtrim(INV_ITEM.THICKNESS))+' '+ltrim(rtrim(T_UOM.UOM_SYMBOL))
                     end,' ') item_size 
                       ,SUM(LD_LINE.ULD_QTY)AS ULD_QTY     
                      ,SUM(LD_LINE.ULD_CONV_QTY)AS ULD_CONV_QTY  
                         ,SUM(LD_LINE.ULD_QTY_ACT)AS QTY_PCS_ACT                          
                          ,SUM(LD_LINE.ULD_QTY_BRKG) AS QTY_PCS_BRKG                  
                            ,AVG(LD_LINE.ITEM_RATE)AS ITEM_RATE                        
                                  ,TRX_UOM.UOM_SYMBOL  UOM_SYMBOL                   
                                     , SUM(LD_LINE.ULD_CONV_QTY) * AVG( LD_LINE.ITEM_RATE)AS AMOUNT
                          , uomd.uom_id uom_idp , uomd.uom_desc uom_descp 
,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,LD_LINE.UOM_ID   
     FROM MTL_ULD_HDR_F LD_HDR
                                INNER JOIN MTL_ULD_LINE_F LD_LINE
                                        ON (LD_HDR.ULD_HDR_ID = LD_LINE.ULD_HDR_ID )
                                INNER JOIN MTL_INVENTORY_ITEM_D INV_ITEM
                                        ON (LD_LINE.INVENTORY_ITEM_ID = INV_ITEM.INVENTORY_ITEM_ID)
                                 
                                 LEFT OUTER JOIN mtl_type_d mtl_type_d
                                         ON(INV_ITEM.PRD_TYPE_ID =mtl_type_d.PRD_TYPE_ID)
                                       LEFT OUTER JOIN mtl_modality_d mtl_modality_d
                                         ON(INV_ITEM.MODALITY_ID=mtl_modality_d.MODALITY_ID)
                                         LEFT OUTER JOIN mtl_category_d mtl_category_d
                                         ON(INV_ITEM.CATEGORY_ID=mtl_category_d.CATEGORY_ID) 
                                     LEFT OUTER JOIN mtl_color_d mtl_color_d
                                         ON(INV_ITEM.COLOR_ID=mtl_color_d.COLOR_ID)
                                    LEFT OUTER JOIN UOM_D TRX_UOM                                      
                                           ON (LD_LINE.UOM_ID = TRX_UOM.UOM_ID)	
 LEFT OUTER JOIN UOM_D L_UOM                                      
                     ON (L_UOM.UOM_ID = INV_ITEM.L_UOM)	
                   LEFT OUTER JOIN UOM_D B_UOM                                      
                     ON (B_UOM.UOM_ID = INV_ITEM.B_UOM)
          LEFT OUTER JOIN UOM_D T_UOM                                      
                     ON (T_UOM.UOM_ID = INV_ITEM.T_UOM)
 INNER JOIN uom_d uomd ON (INV_ITEM.uom_id = uomd.uom_id)
 WHERE LD_LINE.ULD_HDR_ID = $P{ULD_HDR_ID}

GROUP BY 
   TRX_UOM.UOM_SYMBOL           
,LD_LINE.ITEM_RATE
,mtl_type_d.PRD_TYPE_DESC
,mtl_modality_d.MODALITY_DESC
,mtl_category_d.CATEGORY_DESC
,mtl_color_d.COLOR_DESC
  ,INV_ITEM.LENGTH
    ,INV_ITEM.BREADTH
,INV_ITEM.THICKNESS
,INV_ITEM.item_class_id
  ,item_desc,L_UOM.UOM_SYMBOL,B_UOM.UOM_SYMBOL,T_UOM.UOM_SYMBOL
,uomd.uom_id,uomd.uom_desc,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,LD_LINE.UOM_ID]]></queryString>

	<field name="ITEM_SIZE" class="java.lang.String"/>
	<field name="ITEM_DESC" class="java.lang.String"/>
	<field name="ULD_QTY" class="java.lang.Integer"/>
	<field name="ULD_CONV_QTY" class="java.lang.String"/>
	<field name="QTY_PCS_BRKG" class="java.lang.Integer"/>
	<field name="QTY_PCS_ACT" class="java.lang.Integer"/>
	<field name="UOM_SYMBOL" class="java.lang.String"/>
	<field name="AMOUNT" class="java.lang.Float"/>
	<field name="ITEM_RATE" class="java.lang.Integer"/>
	<field name="uom_descp" class="java.lang.String"/>
	<field name="length" class="java.lang.Double"/>
	<field name="breadth" class="java.lang.Double"/>
	<field name="height" class="java.lang.Double"/>
	<field name="UOM_ID" class="java.lang.Integer"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{AMOUNT}.floatValue())]]></variableExpression>
	</variable>
	<variable name="PCS_COUNT" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{UOM_ID}.toString()
,$F{length}.toString(),$F{breadth}.toString(),$F{height}.toString(),Double.parseDouble($F{ULD_CONV_QTY}.toString()))]]></variableExpression>
	</variable>

