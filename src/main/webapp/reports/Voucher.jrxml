	<parameter name="je_hdr_id" isForPrompting="true" class="java.lang.String"/>
	<parameter name="je_voucher_no" isForPrompting="true" class="java.lang.String"/>
	<parameter name="exchange_rate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="je_date" isForPrompting="true" class="java.lang.String"/>
	<parameter name="acct_name" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT je.je_hdr_id
      ,combination.acct_name     
      ,je.je_line_remarks
     ,je.accounted_dr
 ,   je.entered_dr
  ,   je.entered_cr
,payment_schedule.ref_no
   ,currency.currency_short_name
  FROM gl_je_f je
left outer join gl_code_combination_d combination
on(combination.CODE_COMBINATION_ID =je.cash_bank)
left outer join currency_d currency 
on(currency.currency_id =je.currency_id)
left outer join gl_payment_schedule_f payment_schedule 
on(payment_schedule.je_hdr_id =je.je_hdr_id)
 WHERE je.je_hdr_id =$P{je_hdr_id}]]></queryString>

