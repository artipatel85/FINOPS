	<field name="ref_no" class="java.lang.String"/>
	<variable name="TOTAL_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{accounted_dr}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_CREDIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{accounted_cr}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="BALANCE" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{BALANCE}.add($F{accounted_dr}.subtract($F{accounted_cr}))]]></variableExpression>
		<initialValueExpression><![CDATA[$P{openingBalance}]]></initialValueExpression>
	</variable>
