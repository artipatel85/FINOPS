	<parameter name="companyId" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="company" class="java.lang.String" isForPrompting="false"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String"/>
	<parameter name="codeCombinationId" class="java.lang.Integer"/>
	<parameter name="acctName" class="java.lang.String"/>
	<parameter name="openingBalance" class="java.math.BigDecimal"/>
	<parameter name="closingBalance" class="java.math.BigDecimal"/>
	<parameter name="openingBalCR" class="java.math.BigDecimal"/>
	<parameter name="closingBalCR" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[SELECT CONVERT(CHAR(10),je.je_date,120) je_date,je_source_hdr_id,cc1.acct_name CACCT,
(CASE WHEN je.chq_no <> '' THEN ('CH. NO. '+je.chq_no+' DTD. '+CONVERT(char(10),je.chq_date,120)) +' :: ' ELSE '' END +
je.je_source+' :: ' + CASE WHEN trx.awb_bl_no IS NULL THEN cc2.acct_name ELSE 'BL NO - '+trx.awb_bl_no END +
CASE WHEN trx.inv_sb_no IS NOT NULL THEN ' :: INV NO - '+trx.inv_sb_no+' :: '+cc2.acct_name ELSE '' END +
CASE WHEN trx.total_tds > 0 THEN ' :: TDS ON '+CAST((trx.total_taxable+trx.total_non_taxable+trx.total_tax) AS VARCHAR) ELSE '' END) acct_name
,je.je_voucher_no,je.je_source ,je.je_hdr_id,
CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_dr ELSE  je.accounted_dr end accounted_dr ,
CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_cr ELSE  je.accounted_cr end accounted_cr ,
je.je_line_id ,je.attribute8 ,je.je_line_remarks,je.chq_no,CONVERT(char(10),je.chq_date,120) chq_date,trx.awb_bl_no,je.reference2 ref_no
FROM (SELECT * FROM gl_je_f WHERE acct_year = $P{acctYear}
UNION SELECT * FROM gl_je_f WHERE hdr_line_flag = 'L'
AND acct_year = $P{acctYear}) je
LEFT OUTER JOIN gl_code_combination_d cc1 ON (je.code_combination_id=cc1.code_combination_id)
LEFT OUTER JOIN gl_code_combination_d cc2 ON (je.cash_bank=cc2.code_combination_id)
LEFT OUTER JOIN ar_customer_trx_f trx ON (trx.customer_trx_id=je.je_source_hdr_id AND je.je_source IN ('INVOICE','EXPENSE'))
WHERE je.COMPANY_ID=$P{companyId} and je.status='A' AND je.acct_year=$P{acctYear}
AND je.je_date BETWEEN $P{fromDate} AND $P{toDate}
AND je.code_combination_id=$P{codeCombinationId}
ORDER BY je.je_date,je.je_source]]>
	</queryString>
