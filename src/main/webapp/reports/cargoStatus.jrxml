	<field name="shpraddress" class="java.lang.String"/>
	<field name="cneeaddress" class="java.lang.String"/>
	<field name="destaddress" class="java.lang.String"/>
	<field name="loadingaddress" class="java.lang.String"/>
	<field name="destccid" class="java.lang.Integer"/>
	<field name="M_BL_NUMBER" class="java.lang.String"/>
	<field name="linesealno" class="java.lang.String"/>
	<field name="customsealno" class="java.lang.String"/>
	<background>
