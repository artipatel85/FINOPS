	<queryString>
		<![CDATA[select convert(char(10),je_date,120) AS je_date
from gl_je_f where je_date between $P{FromDate} and $P{ToDate} and cash_bank=$P{CodeCombId}
and je_source not in('BILLING') and hdr_line_flag='L' and company_id=$P{COMPANY_ID}

group by je_date]]>
	</queryString>
