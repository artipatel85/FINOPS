<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cash_book" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="ADDRESS" class="java.lang.String"/>
	<parameter name="AcctYear" class="java.lang.String"/>
	<parameter name="Company" class="java.lang.String"/>
	<parameter name="ToDate" class="java.lang.String"/>
	<parameter name="FromDate" class="java.lang.String"/>
	<parameter name="CodeCombId" class="java.lang.String"/>
	<parameter name="AcctName" class="java.lang.String"/>
	<parameter name="openingBal" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPANY_ID" class="java.lang.String"/>
	<parameter name="openingBalCr" class="java.lang.Double" isForPrompting="false">
		<defaultValueExpression><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="ByTo" class="java.lang.String" isForPrompting="false"/>
	<parameter name="lineAcctName" class="java.lang.String"/>
	<parameter name="balAsPerBank" class="java.lang.String"/>
	<parameter name="balAsPerBank1" class="java.lang.String"/>
	<parameter name="balAsPerComp1" class="java.lang.String"/>
	<parameter name="balAsPerComp" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT bal.opn_bal,CONVERT(CHAR(10),je.je_date,120) je_date,je_source_hdr_id,cc1.acct_name acct_name
                ,cc2.acct_name ACCT,je.je_voucher_no
                ,je.je_source ,je.je_hdr_id,


 case when cast(je.accounted_cr as varchar) > '0.00' then cast(je.accounted_cr as varchar) else '' end as enteredcr
,case when cast(je.accounted_dr as varchar) > '0.00' then cast(je.accounted_dr as varchar) else '' end as entereddr
,case when je.je_source in ('CONTRA','RECEIPT') then 'To'when je.je_source in ('PAYMENT') then 'By'  end as by_to
                ,CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_dr
                ELSE  je.accounted_dr end entered_dr ,
                CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_cr
                ELSE  je.accounted_cr end entered_cr
                 ,je.je_line_id ,je.attribute8 ,je.je_line_remarks
				FROM (SELECT * FROM gl_je_f WHERE je_source NOT IN ('STNPUR','GENPUR') AND acct_year =$P{AcctYear}
					 UNION SELECT * FROM gl_je_f WHERE je_source IN ('STNPUR','GENPUR') AND hdr_line_flag = 'L' AND acct_year = $P{AcctYear}) je
                LEFT OUTER JOIN gl_code_combination_d cc1
                  ON (je.code_combination_id=cc1.code_combination_id)
                LEFT OUTER JOIN gl_code_combination_d cc2
                 ON (je.cash_bank=cc2.code_combination_id)
left outer join gl_balances_f bal on(je.code_combination_id=bal.code_combination_id and bal.acct_year=$P{AcctYear} and bal.company_id=$P{COMPANY_ID})

                WHERE je.COMPANY_ID=$P{COMPANY_ID} and je.status='A'
				AND je.acct_year=$P{AcctYear}
AND je.hdr_line_flag='L' AND je.cash_bank=$P{CodeCombId}
AND je.je_date BETWEEN $P{FromDate} AND $P{ToDate}
 UNION
                    select bal.opn_bal,CONVERT(CHAR(10),je.je_date,120) je_date
                    ,je_source_hdr_id,cc1.acct_name acct_name
                    ,cc2.acct_name ACCT
                    ,je.je_voucher_no,je.je_source,je.je_hdr_id,

case when cast(je.accounted_cr as varchar) > '0.00' then cast(je.accounted_cr as varchar) else '' end as enteredcr
,case when cast(je.accounted_dr as varchar) > '0.00' then cast(je.accounted_dr as varchar) else '' end as entereddr
  ,case when je.je_source in ('CONTRA','RECEIPT') then 'To'when je.je_source in ('PAYMENT') then 'By'  end as by_to

                 ,  case when (je.je_source ='JOURNAL') then je.accounted_dr
                    else  je.accounted_dr end entered_dr ,
                    case when (je.je_source ='JOURNAL') then je.accounted_cr
                    else  je.accounted_cr end entered_cr
                    ,je.je_line_id
                    ,je.attribute8 ,je.je_line_remarks

          from gl_je_f je
                   left outer join gl_code_combination_d cc1
                    on (je.code_combination_id=cc1.code_combination_id)
                   left outer join gl_code_combination_d cc2 on (je.cash_bank=cc2.code_combination_id)
    left outer join gl_balances_f bal on(je.code_combination_id=bal.code_combination_id and bal.acct_year=$P{AcctYear} and bal.company_id=$P{COMPANY_ID})

 where je.COMPANY_ID= $P{COMPANY_ID} and je.acct_year= $P{AcctYear}
                    and je.hdr_line_flag='H' and je.status='A' and je.cash_bank=$P{CodeCombId}

ORDER BY je_date,je.je_voucher_no]]>
	</queryString>
