	<field name="entered_cr" class="java.math.BigDecimal"/>
	<field name="je_line_id" class="java.lang.Integer"/>
	<field name="attribute8" class="java.sql.Timestamp"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<variable name="SUM_PO_RATE_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_dr}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_PO_RATE_2" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_cr}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalCrBal" class="java.lang.Double">
		<variableExpression><![CDATA[new Double($P{openingBalCr}.doubleValue()+$V{SUM_PO_RATE_1}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalDrBal" class="java.lang.Double">
		<variableExpression><![CDATA[new Double($P{openingBal}.doubleValue()+$V{SUM_PO_RATE_2}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="cloBal" class="java.lang.Double">
		<variableExpression><![CDATA[new Double($V{totalDrBal}.doubleValue()+$V{totalCrBal}.doubleValue())]]></variableExpression>
	</variable>
