<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="cash_book_subreport0"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="535"
		 pageHeight="802"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="je_date" isForPrompting="false" class="java.lang.String"/>
	<parameter name="AcctYear" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_ID" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select je.je_voucher_no,je.je_source,je.je_line_remarks,je.entered_cr,je.entered_dr
,cc.acct_name,case 
when je.je_source in ('CONTRA','RECEIPT') then 'To'
when je.je_source in ('PAYMENT') then 'By'  end as by_to
,case when cast(je.entered_cr as varchar) > '0.00' then cast(je.entered_cr as varchar) else '' end as enteredcr
,case when cast(je.entered_dr as varchar) > '0.00' then cast(je.entered_dr as varchar) else '' end as entereddr
,bal.opn_bal
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
left outer join gl_balances_f bal on(je.code_combination_id=bal.code_combination_id and bal.acct_year=$P{AcctYear} and bal.company_id=$P{COMPANY_ID})
where je.hdr_line_flag='L' and je.je_date=$P{je_date} and je.je_source not in('BILLING','JOURNAL')
and je.acct_year=$P{AcctYear} and je.company_id=$P{COMPANY_ID}]]></queryString>

	<field name="je_voucher_no" class="java.lang.String"/>
	<field name="je_source" class="java.lang.String"/>
	<field name="entered_dr" class="java.lang.Float"/>
	<field name="entered_cr" class="java.lang.Float"/>
	<field name="entereddr" class="java.lang.String"/>
	<field name="enteredcr" class="java.lang.String"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="by_to" class="java.lang.String"/>
	<field name="opn_bal" class="java.lang.String"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{entered_dr}.floatValue())]]></variableExpression>
	</variable>
	<variable name="SUM_PO_RATE_2" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{entered_cr}.floatValue())]]></variableExpression>
	</variable>
	<variable name="ClosingBal" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[Double.valueOf($V{SUM_PO_RATE_1}.doubleValue()-$V{SUM_PO_RATE_2}.doubleValue())]]></variableExpression>
	</variable>
