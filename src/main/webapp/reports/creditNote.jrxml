	<queryString><![CDATA[select je.code_combination_id,je.entered_dr,je.entered_cr,je.je_hdr_id,je.je_line_id
,je.je_line_remarks ,je.creation_date
,case when je.entered_cr > 0  then 'To  '+cc.acct_name  else '       '+cc.acct_name+ '   Dr' end as acct_name
from gl_je_f je 
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
where je.je_source='CREDIT' and je.hdr_line_flag='L' and je.je_voucher_no=$P{je_voucher_no} and je.acct_year= $P{AcctYear}
group by je.code_combination_id,je.entered_dr,cc.acct_name,je.je_hdr_id,je.je_line_id,je.je_line_remarks,
je.je_line_remarks,je.entered_cr,je.creation_date order by je.creation_date]]></queryString>

