	<parameter name="Company" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ToDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FromDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="COMPANY_ID" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[select convert(char(10),je.je_date,120) AS je_date ,je.je_voucher_no,je.je_source,
je.je_line_remarks,je.entered_cr,je.entered_dr
,cc.acct_name
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)

where je.hdr_line_flag='L' and  je.je_date between $P{FromDate} and $P{ToDate} 
and je.je_source in('CREDIT')
and je.acct_year=$P{AcctYear} and je.company_id=$P{COMPANY_ID}]]></queryString>

