	<parameter name="ORDER_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ORDER_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CUSTOMER_NAME" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ORDER_BOOKED_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PAYMENT_INSTRUCTION" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CUST_SITE_NAME" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CURRENCY_SHORT_NAME" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TERM_OTHERS" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CUST_PO_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CNF_FOB" isForPrompting="false" class="java.lang.String"/>
	<parameter name="CUST_PO_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ORD_HDR_REMARKS" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT    XREF.PARTY_ITEM_DESC
                           
	,XREF.ITEM_SIZE
                                  
	,CAST(SUM(ORD_LINE.ORDER_QTY) AS DECIMAL(15,2)) AS QTY_PCS                                       
          ,UOM.UOM_SYMBOL  UOM_SYMBOL                                 
	,CAST(AVG(ORD_LINE.ITEM_RATE)AS DECIMAL(15,2)) AS ITEM_RATE   
   
                                      

 ,CAST(SUM(ORD_LINE.ORDER_QTY) * AVG(ORD_LINE.ITEM_RATE)AS DECIMAL(15,2)) AS AMOUNT                                
	
   FROM OM_ORDER_HDR_F ORD_HDR                                   
	INNER JOIN OM_ORDER_LINE_F ORD_LINE
                                       
	ON (ORD_HDR.ORDER_HDR_ID = ORD_LINE.ORDER_HDR_ID ) 
	INNER JOIN MTL_XREF_D XREF                                      
	ON (ORD_LINE.INVENTORY_ITEM_ID = XREF.INVENTORY_ITEM_ID	AND ORD_HDR.CUSTOMER_ID = XREF.PARTY_ID) 
	 INNER JOIN MTL_INVENTORY_ITEM_D INV
       ON (ORD_LINE.INVENTORY_ITEM_ID = INV.INVENTORY_ITEM_ID)     
     LEFT OUTER JOIN UOM_D UOM    
     ON (ORD_LINE.UOM_ID = UOM.UOM_ID)	
	WHERE ORD_LINE.ORDER_HDR_ID = $P{ORDER_HDR_ID} 
	
GROUP BY 
XREF.PARTY_ITEM_DESC 
,XREF.ITEM_SIZE
 ,UOM_SYMBOL]]></queryString>

	<field name="PARTY_ITEM_DESC" class="java.lang.String"/>
	<field name="ITEM_SIZE" class="java.lang.String"/>
	<field name="QTY_PCS" class="java.lang.Double"/>
	<field name="UOM_SYMBOL" class="java.lang.String"/>
	<field name="AMOUNT" class="java.lang.Float"/>
	<field name="ITEM_RATE" class="java.lang.Double"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{AMOUNT}.floatValue())]]></variableExpression>
	</variable>

