<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="daily_prod_note"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="700"
		 pageHeight="842"
		 columnWidth="700"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="14"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<style 
		name="noBottomBorder"
		isDefault="false"
		topBorder="Thin"
		topBorderColor="#9999FF"
		leftBorder="Thin"
		leftBorderColor="#9999FF"
		rightBorder="Thin"
		rightBorderColor="#9999FF"
	/>
	<style 
		name="Shaded"
		isDefault="false"
		backcolor="#666666"
	/>
	<style 
		name="Lightshaded"
		isDefault="true"
		backcolor="#CCCCCC"
	/>

	<parameter name="DPN_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="REF_DOC_NO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="REMARKS" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PI_SAMPLE_STOCK" isForPrompting="true" class="java.lang.String"/>
	<parameter name="SHIFT_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="DPN_HDR_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="DPN_HDR_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COST_CENTER_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="MACHINE_NO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CATEGORY_DESC" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT  case when INV_ITEM.item_class_id in (1001,1002,1003) then
 (RTRIM(LTRIM(mtl_type_d.PRD_TYPE_DESC))+ ' '+
       RTRIM(LTRIM(mtl_modality_d.MODALITY_DESC))+' '+
       RTRIM(LTRIM(mtl_category_d.CATEGORY_DESC))+' '+
       RTRIM(LTRIM(mtl_color_d.COLOR_DESC))) 
 else inv_item.item_desc
       end item_desc
      ,coalesce(case when inv_item.item_class_id in (1001,1002,1003) then

       ltrim(rtrim(INV_ITEM.LENGTH))+' X '+
       ltrim(rtrim(INV_ITEM.BREADTH))+' X '+
       ltrim(rtrim(INV_ITEM.THICKNESS)) 
   end,' ') item_size 
      ,FMO_HDR.FMO_NUMBER		
      ,cc.cc_name                                      
      ,DPN_LINE.DPN_LINE_REMARK 
      ,TRX_UOM.UOM_SYMBOL  UOM_SYMBOL              
      ,CAST(SUM(DPN_LINE.DPN_QTY_ACT) AS DECIMAL(15)) AS QTY_PCS_ACT 
      ,CAST(SUM(DPN_LINE.DPN_CONV_QTY_ACT) AS DECIMAL(15)) AS DPN_CONV_QTY_ACT       
      ,CAST(SUM(DPN_LINE.DPN_QTY_BRKG) AS DECIMAL (15)) AS QTY_PCS_BRKG                   
      ,CAST(AVG(DPN_LINE.DPN_RATE) AS DECIMAL(15,2)) AS RATE
      ,SUM(DPN_LINE.DPN_CONV_QTY_ACT) * AVG( DPN_LINE.DPN_RATE) AS AMOUNT
   ,minhdr.min_no ,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,DPN_LINE.uom_id
    FROM WIP_DPN_HDR_F DPN_HDR
     INNER JOIN WIP_DPN_LINE_F DPN_LINE ON (DPN_HDR.DPN_HDR_ID = DPN_LINE.DPN_HDR_ID )
     LEFT OUTER JOIN FMO_LINE_F FMO_LINE    ON (DPN_LINE.FMO_LINE_ID = FMO_LINE.FMO_LINE_ID)
     LEFT OUTER JOIN FMO_HDR_F FMO_HDR      ON (FMO_HDR.FMO_HDR_ID = FMO_LINE.FMO_HDR_ID)
     left outer JOIN OM_ORDER_LINE_F ODR_LN ON (ODR_LN.ORDER_LINE_ID = DPN_LINE.DPN_LINE_ID)
     left outer JOIN OM_ORDER_HDR_F ODR     ON (ODR.ORDER_HDR_ID = ODR_LN.ORDER_HDR_ID)
     LEFT OUTER JOIN COST_CENTER_D CC       ON(DPN_HDR.CC_ID = CC.CC_ID)   
     LEFT OUTER JOIN MTL_INVENTORY_ITEM_D INV_ITEM  ON (DPN_LINE.INVENTORY_ITEM_ID = INV_ITEM.INVENTORY_ITEM_ID)
     LEFT OUTER JOIN mtl_type_d mtl_type_d          ON(INV_ITEM.PRD_TYPE_ID =mtl_type_d.PRD_TYPE_ID)
     LEFT OUTER JOIN mtl_modality_d mtl_modality_d  ON(INV_ITEM.MODALITY_ID=mtl_modality_d.MODALITY_ID)
     LEFT OUTER JOIN mtl_category_d mtl_category_d  ON(INV_ITEM.CATEGORY_ID=mtl_category_d.CATEGORY_ID) 
     LEFT OUTER JOIN mtl_color_d mtl_color_d        ON(INV_ITEM.COLOR_ID=mtl_color_d.COLOR_ID)
     LEFT OUTER JOIN UOM_D TRX_UOM                  ON (DPN_LINE.UOM_ID = TRX_UOM.UOM_ID)
left outer join mtl_issue_note_line_f minline on(minline.MIN_LINE_ID=DPN_LINE.MIN_LINE_ID)     
left outer join mtl_issue_note_hdr_f minhdr     on(minhdr.MIN_HDR_ID=minline.MIN_HDR_ID)  	

 WHeRE DPN_LINE.DPN_HDR_ID  =$P{DPN_HDR_ID}
 GROUP BY FMO_HDR.FMO_NUMBER		
         ,cc.cc_name       
 ,TRX_UOM.UOM_SYMBOL                        
         ,DPN_LINE.DPN_LINE_REMARK
         ,mtl_type_d.PRD_TYPE_DESC
         ,mtl_modality_d.MODALITY_DESC
         ,mtl_category_d.CATEGORY_DESC
         ,mtl_color_d.COLOR_DESC
         ,INV_ITEM.LENGTH
         ,INV_ITEM.BREADTH    
         ,INV_ITEM.THICKNESS
          ,INV_ITEM.item_class_id
          ,item_desc,minhdr.min_no,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,DPN_LINE.UOM_ID]]></queryString>

	<field name="ITEM_DESC" class="java.lang.String"/>
	<field name="ITEM_SIZE" class="java.lang.String"/>
	<field name="DPN_CONV_QTY_ACT" class="java.lang.String"/>
	<field name="RATE" class="java.lang.Float"/>
	<field name="AMOUNT" class="java.lang.Float"/>
	<field name="FMO_NUMBER" class="java.lang.String"/>
	<field name="UOM_SYMBOL" class="java.lang.String"/>
	<field name="QTY_PCS_ACT" class="java.lang.Integer"/>
	<field name="cc_name" class="java.lang.String"/>
	<field name="QTY_PCS_BRKG" class="java.lang.Integer"/>
	<field name="DPN_LINE_REMARK" class="java.lang.String"/>
	<field name="min_no" class="java.lang.String"/>
	<field name="length" class="java.lang.Double"/>
	<field name="breadth" class="java.lang.Double"/>
	<field name="height" class="java.lang.Double"/>
	<field name="UOM_ID" class="java.lang.Integer"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Float" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Float($F{AMOUNT}.floatValue())]]></variableExpression>
	</variable>
	<variable name="PCS_COUNT" class="java.lang.String" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new com.avance.erp.util.UnitConverterPcs().getUnitConverted($F{UOM_ID}.toString()
,$F{length}.toString(),$F{breadth}.toString(),$F{height}.toString(),Double.parseDouble($F{DPN_CONV_QTY_ACT}.toString()))]]></variableExpression>
	</variable>

