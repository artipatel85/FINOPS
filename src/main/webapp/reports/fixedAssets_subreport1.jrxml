	<parameter name="COMPANY_ID" isForPrompting="false" class="java.lang.String"/>
	<parameter name="AcctYr" isForPrompting="false" class="java.lang.String"/>
	<parameter name="code_combination_id" isForPrompting="false" class="java.lang.String"/>
	<parameter name="acct_id" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select cc.acct_name,bal.opn_bal,bal.add_before_6_mnths,bal.add_after_6_mnths,
            bal.deletiors,bal.dep_for_12_mnths,    bal.dep_for_6_mnths,cc.rate_of_dep,
            (bal.opn_bal+bal.add_before_6_mnths+bal.add_after_6_mnths-bal.deletiors)total,
            (bal.dep_for_6_mnths+bal.dep_for_12_mnths) totDepriciation,
((bal.opn_bal+bal.add_before_6_mnths+bal.add_after_6_mnths)-(bal.dep_for_6_mnths+bal.dep_for_12_mnths)) net 
             from gl_balances_f bal 
             left outer join gl_code_combination_d cc on(bal.code_combination_id=cc.code_combination_id) 
            where cc.parent_id=$P{acct_id}  and cc.acct_flag='L'

and bal.COMPANY_ID=$P{COMPANY_ID} and bal.acct_year=$P{AcctYr}]]></queryString>

