	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="acct_id" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_ID" isForPrompting="false" class="java.lang.String"/>
	<parameter name="AcctYr" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select sum(bal.opn_bal)obt1,sum(bal.add_before_6_mnths)absmt1,sum(bal.add_after_6_mnths)aasmt1,
sum(bal.deletiors)dt1,
sum(bal.dep_for_12_mnths)dftmt1,   sum(bal.dep_for_6_mnths)dfsmt1,
sum((bal.opn_bal+bal.add_before_6_mnths+bal.add_after_6_mnths-bal.deletiors))total1,
sum((bal.dep_for_6_mnths+bal.dep_for_12_mnths)) totDepriciation1,
sum(((bal.opn_bal+bal.add_before_6_mnths+bal.add_after_6_mnths)-(bal.dep_for_6_mnths+bal.dep_for_12_mnths)))net1 
 from gl_balances_f bal  
left outer join gl_code_combination_d cc on(bal.code_combination_id=cc.code_combination_id) 
where cc.parent_id=$P{acct_id}  and cc.acct_flag='L'

and bal.COMPANY_ID=$P{COMPANY_ID} and bal.acct_year=$P{AcctYr}]]></queryString>

