	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="je_voucher_no" class="java.lang.String"/>
	<parameter name="je_date" class="java.lang.String"/>
	<parameter name="acct_year" class="java.lang.String"/>
	<parameter name="company_name" class="java.lang.String"/>
	<parameter name="entered_cr" class="java.lang.String"/>
	<parameter name="entered_dr" class="java.lang.String"/>
	<parameter name="remarks" class="java.lang.String"/>
	<parameter name="CHANGEWORD" class="java.lang.String"/>
	<parameter name="ADDRESS" class="java.lang.String"/>
	<queryString>
		<![CDATA[select je.code_combination_id
,je.entered_dr
,je.entered_cr
,je.so_number
,je.bl_no
,case when cost.bl_no  <>  '' then 'B/L : '+ cost.bl_no  else '' end as cc_name

,CASE WHEN je.entered_dr ='0.00' THEN  '' ELSE je.entered_dr END AS entered_dr1
,CASE WHEN je.entered_cr ='0.00' THEN  '' ELSE je.entered_cr  END AS entered_cr1

,je.je_hdr_id,je.je_line_id
,je.je_line_remarks
,case when je.je_line_id > 1  then concat('To  ',cc.acct_name)  else concat('       ',cc.acct_name) end as acct_name
,je.created_by,je.amended_by,je.amended_date,je.sac_code
from gl_je_f je
left outer join gl_code_combination_d cc on(je.code_combination_id=cc.code_combination_id)
left outer join bl_hdr_f cost on(je.bl_no=cost.bl_no)

where je.je_source='JOURNAL' and je.je_voucher_no=$P{je_voucher_no} and je.acct_year=$P{acct_year}

 order by je_line_id]]>
	</queryString>
