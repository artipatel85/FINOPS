	<parameter name="irn" class="java.lang.String"/>
	<queryString>
		<![CDATA[select je.code_combination_id
,je.entered_dr
,je.entered_cr
,je.so_number
,je.bl_no
,je.entered_dr entered_dr1
,je.entered_cr entered_cr1
,je.je_hdr_id,je.je_line_id
,je.je_line_remarks
,(case when (trxlines.CODE_DESC IS not null and trxlines.CODE_DESC <> '') then trxlines.CODE_DESC else cc.ACCT_NAME end) acct_name
,je.created_by
,je.amended_by
,je.amended_date
,trxlines.CODE_DESC
,trxlines.SAC_CODE
,trxlines.SO_NO
,trxlines.BL_NO blnum
from gl_je_f je
left outer join gl_code_combination_d cc on (je.code_combination_id=cc.code_combination_id)
left outer join ar_customer_trx_lines_f trxlines on (trxlines.TRX_NUMBER=je.JE_VOUCHER_NO
and trxlines.CODE_COMBINATION_ID=je.CODE_COMBINATION_ID and trxlines.ACCOUNTED_AMOUNT<>0
and trxlines.REV_EXP_TAX_DISC_OC='R'
and je.je_source_line_id=trxlines.line_no)
where je.je_source='EXPENSE' and je.je_voucher_no=$P{trxno}
AND (je.entered_dr+je.entered_cr) <> 0.00
 order by je_line_id]]>
	</queryString>
