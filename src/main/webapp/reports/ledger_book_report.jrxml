	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="ADDRESS" isForPrompting="true" class="java.lang.String"/>
	<parameter name="AcctYear" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Company" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ToDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FromDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CodeCombId" isForPrompting="true" class="java.lang.String"/>
	<parameter name="AcctName" isForPrompting="true" class="java.lang.String"/>
	<parameter name="openingBal" isForPrompting="false" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPANY_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="closeBal" isForPrompting="true" class="java.lang.Double"/>
	<parameter name="openingBalCr" isForPrompting="false" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="ByTo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="closeBalCr" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="ByToCls" isForPrompting="false" class="java.lang.String"/>
	<parameter name="lineAcctName" isForPrompting="true" class="java.lang.String"/>
	<parameter name="balAsPerBank" isForPrompting="true" class="java.lang.String"/>
	<parameter name="balAsPerBank1" isForPrompting="true" class="java.lang.String"/>
	<parameter name="balAsPerComp1" isForPrompting="true" class="java.lang.String"/>
	<parameter name="balAsPerComp" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT CONVERT(CHAR(10),je.je_date,120) je_date
,je_source_hdr_id
,cc1.acct_name CACCT
                ,cc2.acct_name 
,je.je_voucher_no
                ,je.je_source 
,je.je_hdr_id,
                CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_dr 
                ELSE  je.accounted_dr end entereddr , 
                CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_cr 
                ELSE  je.accounted_cr end enteredcr 
, CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_dr
                ELSE  je.accounted_dr end entered_dr 
,case 
when je.je_source in ('CONTRA','RECEIPT','JOURNAL','EXPORT SALES','DEBIT') then 'By'
when je.je_source in ('GENPUR','STNPUR','PAYMENT','CREDIT') then 'To'  end as by_to, 
                CASE WHEN (je.je_source ='JOURNAL') THEN je.accounted_cr  
                ELSE  je.accounted_cr end entered_cr 

                ,je.je_line_id ,je.attribute8 ,je.je_line_remarks 
				FROM (SELECT * FROM gl_je_f WHERE je_source NOT IN ('STNPUR','GENPUR') AND acct_year = $P{AcctYear} 
				 UNION SELECT * FROM gl_je_f WHERE je_source IN ('STNPUR','GENPUR') AND hdr_line_flag = 'L' AND acct_year = $P{AcctYear}) je 
                LEFT OUTER JOIN gl_code_combination_d cc1
                 ON (je.code_combination_id=cc1.code_combination_id) 
                LEFT OUTER JOIN gl_code_combination_d cc2
                 ON (je.cash_bank=cc2.code_combination_id) 
                WHERE je.COMPANY_ID=$P{COMPANY_ID} and je.status='A' 
				AND je.acct_year=$P{AcctYear}

AND je.je_date between $P{FromDate} and $P{ToDate}
AND je.code_combination_id=$P{CodeCombId} ORDER BY je.je_date,je.je_voucher_no]]></queryString>

	<field name="je_date" class="java.lang.String"/>
	<field name="by_to" class="java.lang.String"/>
	<field name="je_voucher_no" class="java.lang.String"/>
	<field name="je_source" class="java.lang.String"/>
	<field name="entered_dr" class="java.lang.Double"/>
	<field name="entered_cr" class="java.lang.Double"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="entereddr" class="java.lang.String"/>
	<field name="enteredcr" class="java.lang.String"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_dr}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_PO_RATE_2" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_cr}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalCrBal" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Double($P{openingBalCr}.doubleValue()+$V{SUM_PO_RATE_2}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalDrBal" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Double($P{openingBal}.doubleValue()+$V{SUM_PO_RATE_1}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="cloBal" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Double($V{totalDrBal}.doubleValue()+$V{totalCrBal}.doubleValue())]]></variableExpression>
	</variable>
