	<parameter name="ADDRESS" isForPrompting="true" class="java.lang.String"/>
	<parameter name="AcctYear" isForPrompting="true" class="java.lang.String"/>
	<parameter name="Company" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ToDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FromDate" isForPrompting="true" class="java.lang.String"/>
	<parameter name="CodeCombId" isForPrompting="true" class="java.lang.String"/>
	<parameter name="AcctName" isForPrompting="true" class="java.lang.String"/>
	<parameter name="openingBal" isForPrompting="false" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="COMPANY_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="closeBal" isForPrompting="true" class="java.lang.Double"/>
	<parameter name="openingBalCr" isForPrompting="false" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0.00)]]></defaultValueExpression>
	</parameter>
	<parameter name="ByTo" isForPrompting="false" class="java.lang.String"/>
	<parameter name="closeBalCr" isForPrompting="false" class="java.lang.Double"/>
	<parameter name="ByToCls" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select convert(char(12),je.je_date,106) AS je_date ,je.je_voucher_no,je.je_source
,je.je_line_remarks
,je.entered_cr,je.entered_dr
,cc.acct_name,case 
when je.je_source in ('CONTRA','RECEIPT','JOURNAL','EXPORT SALES','DEBIT') then 'To'
when je.je_source in ('GENPUR','STNPUR','PAYMENT','CREDIT') then 'By'  end as by_to
,case when cast(je.entered_cr as varchar) > '0.00' then cast(je.entered_cr as varchar) else '0.00' end as enteredcr
,case when cast(je.entered_dr as varchar) > '0.00' then cast(je.entered_dr as varchar) else '0.00' end as entereddr

from gl_je_f je
left outer join gl_code_combination_d cc on(je.cash_bank=cc.code_combination_id)

where je.hdr_line_flag='L'  and je.code_combination_id=$P{CodeCombId}
and je.acct_year=$P{AcctYear} and je.company_id=$P{COMPANY_ID}]]></queryString>

	<field name="je_date" class="java.lang.String"/>
	<field name="by_to" class="java.lang.String"/>
	<field name="je_voucher_no" class="java.lang.String"/>
	<field name="je_source" class="java.lang.String"/>
	<field name="entered_dr" class="java.lang.Double"/>
	<field name="entered_cr" class="java.lang.Double"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="entereddr" class="java.lang.String"/>
	<field name="enteredcr" class="java.lang.String"/>

	<variable name="SUM_PO_RATE_1" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_dr}.dpubleValue())]]></variableExpression>
	</variable>
	<variable name="SUM_PO_RATE_2" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entered_cr}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalCrBal" class="java.lang.Double" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Double($P{openingBalCr}.doubleValue()+$V{SUM_PO_RATE_1}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="totalDrBal" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($P{openingBal}.doubleValue()+$V{SUM_PO_RATE_2}.doubleValue())]]></variableExpression>
	</variable>
	<variable name="cloBal" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double($V{totalDrBal}.doubleValue()+$V{totalCrBal}.doubleValue())]]></variableExpression>
	</variable>
