	<field name="entereddr" class="java.lang.Float"/>
	<field name="jeaccount" class="java.lang.String"/>
	<variable name="SUM_PO_RATE_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{entereddr}.floatValue())]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.00)]]></initialValueExpression>
	</variable>
	<variable name="SUM_PO_RATE_2" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{enteredcr}.floatValue())]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.00)]]></initialValueExpression>
	</variable>
	<variable name="ClosingBalCr" class="java.lang.String" calculation="Sum">
		<variableExpression><![CDATA[Double.parseDouble($P{openingBal}) < 0 ? new Double($V{SUM_PO_RATE_2}.doubleValue() - $V{SUM_PO_RATE_1}.doubleValue() - Double.parseDouble($P{openingBal})).toString() : ""]]></variableExpression>
		<initialValueExpression><![CDATA["0"]]></initialValueExpression>
	</variable>
	<variable name="ClosingBalDr" class="java.lang.String">
		<variableExpression><![CDATA[Double.parseDouble($P{openingBal}) >= 0 ? new Double($V{SUM_PO_RATE_2}.doubleValue() - $V{SUM_PO_RATE_1}.doubleValue() + Double.parseDouble($P{openingBal})).toString() : ""]]></variableExpression>
		<initialValueExpression><![CDATA["0"]]></initialValueExpression>
	</variable>
	<variable name="openingbalCr" class="java.lang.String" incrementType="Report">
		<variableExpression><![CDATA[Double.parseDouble($P{openingBal}) < 0 ? new Double(Double.parseDouble($P{openingBal}) * (-1)).toString() : "0.00"]]></variableExpression>
		<initialValueExpression><![CDATA["0"]]></initialValueExpression>
	</variable>
	<variable name="openingbalDr" class="java.lang.Double">
		<variableExpression><![CDATA[Double.parseDouble($P{openingBal}) > 0 ? Double.valueOf($P{openingBal}) : Double.valueOf(0.00)]]></variableExpression>
	</variable>
	<variable name="tempclosingBalance" class="java.lang.Double">
		<variableExpression><![CDATA[new Double($V{SUM_PO_RATE_2}.doubleValue() - $V{SUM_PO_RATE_1}.doubleValue() + Double.parseDouble($P{openingBal}))]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0.00)]]></initialValueExpression>
	</variable>
