<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ledger_book_subreport0" pageWidth="535" pageHeight="802" columnWidth="535" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="openingBal" class="java.lang.String"/>
	<parameter name="ToDate" class="java.lang.String"/>
	<parameter name="FromDate" class="java.lang.String"/>
	<parameter name="code_combination_id" class="java.lang.String" isForPrompting="false"/>
	<parameter name="acct_name" class="java.lang.String" isForPrompting="false"/>
	<parameter name="AcctYear" class="java.lang.String"/>
	<parameter name="COMPANY_ID" class="java.lang.String"/>
	<parameter name="mincode" class="java.lang.String"/>
	<parameter name="maxcode" class="java.lang.String"/>
	<queryString>
		<![CDATA[select convert(char(12),je.je_date,106) AS je_date,je.je_voucher_no,je.je_source,je.je_line_remarks,
je.accounted_cr enteredcr,je.accounted_dr entereddr
,cc.acct_name,gcc.acct_name jeaccount,case
when je.je_source in ('CONTRA','RECEIPT','JOURNAL','EXPORT SALES','DEBIT') then 'To'
when je.je_source in ('GENPUR','STNPUR','PAYMENT','CREDIT') then 'By'  end as by_to

from gl_code_combination_d cc
LEFT OUTER JOIN (SELECT * FROM gl_je_f WHERE hdr_line_flag='L'
and acct_year=$P{AcctYear} and company_id=$P{COMPANY_ID}
and je_date between $P{FromDate} and $P{ToDate}) je ON (je.cash_bank=cc.code_combination_id)
LEFT OUTER JOIN gl_code_combination_d gcc ON (gcc.code_combination_id = je.code_combination_id)
where cc.code_combination_id=$P{code_combination_id}
group by je.je_date,je.je_source,je.je_voucher_no,
         je.je_line_remarks,je.accounted_cr,
je.accounted_dr
,cc.acct_name,gcc.acct_name
order by je.je_date]]>
	</queryString>
	<field name="je_date" class="java.lang.String"/>
	<field name="je_voucher_no" class="java.lang.String"/>
	<field name="je_source" class="java.lang.String"/>
	<field name="je_line_remarks" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="by_to" class="java.lang.String"/>
