			<subreport isUsingCache="true">
				<reportElement key="subreport-2" mode="Transparent" x="17" y="0" width="474" height="6" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true"/>
				<subreportParameter name="openingBal">
					<subreportParameterExpression><![CDATA[$F{openingBal}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="ToDate">
					<subreportParameterExpression><![CDATA[$P{ToDate}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="FromDate">
					<subreportParameterExpression><![CDATA[$P{FromDate}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="acct_name">
