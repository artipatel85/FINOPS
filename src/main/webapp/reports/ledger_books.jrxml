<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Trial_Balance" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="ADDRESS" class="java.lang.String"/>
	<parameter name="AcctYear" class="java.lang.String"/>
	<parameter name="Company" class="java.lang.String"/>
	<parameter name="ToDate" class="java.lang.String"/>
	<parameter name="FromDate" class="java.lang.String"/>
	<parameter name="COMPANY_ID" class="java.lang.String"/>
	<parameter name="closeBal" class="java.lang.Double"/>
	<parameter name="maxcode" class="java.lang.String"/>
	<parameter name="mincode" class="java.lang.String"/>
	<queryString>
		<![CDATA[select cc.code_combination_id,comp.description company_name,comp.address1,
                              cc.acct_name,bal._0_0 opn_bal
                              ,case when bal._0_0  > '0.00' then bal._0_0
                                    else bal._0_0 * (-1) end as openingBal
                              from (SELECT * FROM gl_code_combination_d WHERE acct_flag ='L') cc
                   inner join gl_day_balances_f bal on(bal.code_combination_id=cc.code_combination_id and acct_year = $P{AcctYear})
			left outer join company_d comp ON (comp.company_id = cc.company_id)
			order by cc.acct_name,cc.code_combination_id]]>
	</queryString>
	<field name="code_combination_id" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="address1" class="java.lang.String"/>
	<field name="acct_name" class="java.lang.String"/>
	<field name="opn_bal" class="java.math.BigDecimal"/>
	<field name="openingBal" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="42" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement key="textField" x="145" y="2" width="259" height="14"/>
				<box>
