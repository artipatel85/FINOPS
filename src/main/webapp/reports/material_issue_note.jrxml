<?xml version="1.0" encoding="UTF-8"  ?>
<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="material_issue_note"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="700"
		 pageHeight="842"
		 columnWidth="700"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<style 
		name="Shaded"
		isDefault="false"
		backcolor="#666666"
		fontName="Arial"
		fontSize="12"
		isBold="true"
	/>
	<style 
		name="LightShaded"
		isDefault="true"
		backcolor="#CCCCCC"
	/>

	<parameter name="MIN_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="MIN_HDR_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="MIN_HDR_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COST_CENTER_NAME" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[SELECT case when inv_item.item_class_id in (1001,1002,1003) then
 (RTRIM(LTRIM(mtl_type_d.PRD_TYPE_DESC))+ ' '+
       RTRIM(LTRIM(mtl_modality_d.MODALITY_DESC))+' '+
       RTRIM(LTRIM(mtl_category_d.CATEGORY_DESC))+' '+
       RTRIM(LTRIM(mtl_color_d.COLOR_DESC))) 
       else inv_item.item_desc
       end item_desc
      ,case when inv_item.item_class_id in (1001,1002,1003) then
       ltrim(rtrim(INV_ITEM.LENGTH))+' X '+
       ltrim(rtrim(INV_ITEM.BREADTH))+' X '+
       ltrim(rtrim(INV_ITEM.THICKNESS)) 
          end item_size     
         ,cc.cc_name
,MIN_LINE.UOM_ID UOM_ID 
      ,TRX_UOM.UOM_SYMBOL  UOM_SYMBOL   
     ,CAST(SUM(MIN_LINE.MIN_QTY)AS DECIMAL(15,2))AS QTY
      ,CAST(SUM(MIN_LINE.MIN_CONV_QTY)AS DECIMAL(15,2))AS MIN_CONV_QTY
     ,CAST(AVG(MIN_LINE.RATE)AS DECIMAL(15,2))AS RATE
   , CAST(SUM(MIN_LINE.MIN_CONV_QTY)*AVG( MIN_LINE.RATE )AS DECIMAL(15,2))AS AMOUNT
         ,ODR.FMO_NUMBER                                        
       ,MACH.MACHINE_NO  
,CAT.CATEGORY_DESC 
,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height 

 FROM MTL_ISSUE_NOTE_HDR_F MIN_HDR 
INNER JOIN MTL_ISSUE_NOTE_LINE_F MIN_LINE
             ON (MIN_HDR.MIN_HDR_ID = MIN_LINE.MIN_HDR_ID )    
		      			    
            LEFT OUTER JOIN MTL_INVENTORY_ITEM_D INV_ITEM
           ON (MIN_LINE.INVENTORY_ITEM_ID = INV_ITEM.INVENTORY_ITEM_ID)
             
             LEFT OUTER JOIN cost_center_d cc
			ON (MIN_HDR.cc_id = cc.cc_id)   
                      
           LEFT OUTER JOIN fmo_line_f ODR_LN
			ON (MIN_LINE.FMO_LINE_ID =ODR_LN.FMO_LINE_ID)
			 
            LEFT OUTER JOIN FMO_HDR_F ODR 
			ON (ODR_LN.FMO_HDR_ID = ODR.FMO_HDR_ID)
               LEFT OUTER JOIN mtl_type_d mtl_type_d
                                         ON(INV_ITEM.PRD_TYPE_ID =mtl_type_d.PRD_TYPE_ID)
                                       LEFT OUTER JOIN mtl_modality_d mtl_modality_d
                                         ON(INV_ITEM.MODALITY_ID=mtl_modality_d.MODALITY_ID)
                                         LEFT OUTER JOIN mtl_category_d mtl_category_d
                                         ON(INV_ITEM.CATEGORY_ID=mtl_category_d.CATEGORY_ID) 
                                     LEFT OUTER JOIN mtl_color_d mtl_color_d
                                      
                                        ON(INV_ITEM.COLOR_ID=mtl_color_d.COLOR_ID)     
                                     LEFT OUTER JOIN UOM_D TRX_UOM                                      
                                        ON (MIN_LINE.UOM_ID = TRX_UOM.UOM_ID)	
INNER JOIN mtl_category_d CAT
           ON (MIN_LINE.CATEGORY_ID = CAT.CATEGORY_ID )  
INNER JOIN wip_machine_d MACH
           ON (MIN_LINE.MACHINE_ID = MACH.MACHINE_ID )             
         WHERE MIN_HDR.MIN_HDR_ID= $P{MIN_HDR_ID}
        GROUP BY 
  cc.cc_name
,ODR.FMO_NUMBER
,mtl_type_d.PRD_TYPE_DESC
,mtl_modality_d.MODALITY_DESC
,mtl_category_d.CATEGORY_DESC
,mtl_color_d.COLOR_DESC
  ,INV_ITEM.LENGTH
    ,INV_ITEM.BREADTH    
  ,INV_ITEM.THICKNESS
,MIN_LINE.UOM_ID
   ,TRX_UOM.UOM_SYMBOL
 ,inv_item.item_class_id
,item_desc
,MACH.MACHINE_NO   
,CAT.CATEGORY_DESC
,INV_ITEM.length,
INV_ITEM.breadth,INV_ITEM.height]]></queryString>

	<field name="cc_name" class="java.lang.String"/>
	<field name="ITEM_DESC" class="java.lang.String"/>
