	<field name="fromAmount" class="java.math.BigDecimal"/>
	<field name="toAmount" class="java.math.BigDecimal"/>
	<field name="payment_schedule_id" class="java.lang.Integer"/>
	<field name="pi_no" class="java.lang.String"/>
	<field name="pcl_received_amt" class="java.math.BigDecimal"/>
	<field name="pcl_pi_date" class="java.lang.String"/>
	<field name="pi_fc_net_amt" class="java.math.BigDecimal"/>
	<field name="currency_short_name" class="java.lang.String"/>
	<field name="pcl_amount" class="java.math.BigDecimal"/>
	<field name="due_date" class="java.lang.String"/>
	<field name="lc_order_no" class="java.lang.String"/>
	<field name="lc_order_date" class="java.sql.Timestamp"/>
	<field name="lc_order_amt" class="java.math.BigDecimal"/>
	<field name="currency_id" class="java.lang.Integer"/>


