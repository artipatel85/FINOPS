	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<queryString><![CDATA[SELECT pclcc.acct_name,nref.amount_due_original fromAmount,
		COALESCE(aref.amount_due_original,0.00) toAmount,
			nref.payment_schedule_id,
				pihdr.pi_no,pihdr.pcl_received_amt,
		CONVERT(CHAR(10),pihdr.pcl_pi_date,120) pcl_pi_date,
                pihdr.pi_fc_net_amt,cur.currency_short_name,pcl.pcl_amount,
		CONVERT(CHAR(10),pcl.due_date,120) due_date,
                pcl.lc_order_no,pcl.lc_order_date,pcl.lc_order_amt,pcl.currency_id,
		cur.currency_short_name
                FROM pcl_pi_hdr_f pihdr 
                LEFT OUTER JOIN currency_d cur ON (cur.currency_id = pihdr.currency_id) 
                INNER JOIN pcl_advice_f pcl ON (pcl.pcl_pi_hdr_id = pihdr.pcl_pi_hdr_id)
				LEFT OUTER JOIN gl_code_combination_d pclcc ON (pclcc.code_combination_id = pcl.pcl_cc_id)
				LEFT OUTER JOIN (SELECT * FROM gl_je_payment_schedule_f WHERE agnst_payment_schedule_id = 0) nref ON (nref.code_combination_id = pcl.pcl_cc_id)
				LEFT OUTER JOIN (SELECT * FROM gl_je_payment_schedule_f WHERE agnst_payment_schedule_id <> 0) aref 
				ON (aref.agnst_payment_schedule_id = nref.payment_schedule_id)]]></queryString>

