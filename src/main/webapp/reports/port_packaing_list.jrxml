<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="port_packaing_list"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="700"
		 pageHeight="842"
		 columnWidth="700"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<style 
		name="Shaded"
		isDefault="false"
		backcolor="#666666"
	/>
	<style 
		name="Lightshaded"
		isDefault="true"
		backcolor="#CCCCCC"
	/>

	<parameter name="PPL_HDR_ID" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PPL_SNO" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PPL_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TRUCK_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PI_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ORDER_NUMBER" isForPrompting="true" class="java.lang.String"/>
	<parameter name="ORDER_BOOKED_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="PI_DATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TOTAL_WT" isForPrompting="true" class="java.lang.String"/>
	<parameter name="FREIGHT_RATE" isForPrompting="true" class="java.lang.String"/>
	<parameter name="TOTAL_FREIGHT" isForPrompting="true" class="java.lang.String"/>
	<parameter name="LOADING_CHARGES" isForPrompting="false" class="java.lang.String"/>
	<parameter name="OTHER_CHARGES" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="TRUCK_ADVANCE" isForPrompting="false" class="java.lang.String"/>
	<parameter name="CITY_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="CUSTOMER_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="BILLTY_NO" isForPrompting="false" class="java.lang.String"/>
	<parameter name="COST_CENTER_NAME" isForPrompting="false" class="java.lang.String"/>
	<parameter name="LD_HDR_REMARKS" isForPrompting="true" class="java.lang.String"/>
	<parameter name="VALUATION" isForPrompting="true" class="java.lang.String"/>
	<parameter name="USER_NAME" isForPrompting="true" class="java.lang.String"/>
	<queryString><![CDATA[SELECT  case when INV_ITEM.item_class_id in (1001,1002,1003) then
(ltrim(rtrim(mtl_type_d.PRD_TYPE_DESC))+' '+
       ltrim(rtrim(mtl_modality_d.MODALITY_DESC))+' '+
       ltrim(rtrim(mtl_category_d.CATEGORY_DESC))+' '+
       ltrim(rtrim(mtl_color_d.COLOR_DESC))) 
       else inv_item.item_desc
       end item_desc
      ,coalesce(case when inv_item.item_class_id in (1001,1002,1003) then
      ltrim(rtrim(INV_ITEM.LENGTH))+' X '+
       ltrim(rtrim(INV_ITEM.BREADTH))+' X '+
       ltrim(rtrim(INV_ITEM.THICKNESS)) 
       end,' ') item_size 
      ,PPL_LINE.PPL_LINE_NO
      ,PPL_LINE.FROM_CRT_NO
      ,PPL_LINE.TO_CRT_NO
          ,TRX_UOM.UOM_SYMBOL  UOM_SYMBOL      
               ,SUM(PPL_LINE.TOT_CRT)  AS TOT_CRT
               ,SUM(PPL_LINE.PPL_CONV_QTY) AS PPL_CONV_QTY                                 
                ,cast(SUM(PPL_LINE.PPL_QTY)as int) AS PPL_QTY                   
               ,SUM(PPL_LINE.PPL_CONV_QTY) * SUM(PPL_LINE.TOT_CRT)  AS  TOTPCS          
               ,PPL_LINE.PPL_LINE_REMARK,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,PPL_LINE.UOM_ID
       FROM MTL_PPL_HDR_F PPL_HDR
                                INNER JOIN MTL_PPL_LINE_F PPL_LINE ON
                                    (PPL_HDR.PPL_HDR_ID = PPL_LINE.PPL_HDR_ID)
								LEFT OUTER JOIN MTL_INVENTORY_ITEM_D INV_ITEM ON
                                    (PPL_LINE.INVENTORY_ITEM_ID = INV_ITEM.INVENTORY_ITEM_ID)
                               
                                LEFT OUTER JOIN mtl_type_d mtl_type_d
                                         ON(INV_ITEM.PRD_TYPE_ID =mtl_type_d.PRD_TYPE_ID)
                                LEFT OUTER JOIN mtl_modality_d mtl_modality_d
                                         ON(INV_ITEM.MODALITY_ID=mtl_modality_d.MODALITY_ID)
                                 LEFT OUTER JOIN mtl_category_d mtl_category_d
                                         ON(INV_ITEM.CATEGORY_ID=mtl_category_d.CATEGORY_ID) 
                                 LEFT OUTER JOIN mtl_color_d mtl_color_d
                                         ON(INV_ITEM.COLOR_ID=mtl_color_d.COLOR_ID)
                                LEFT OUTER JOIN UOM_D TRX_UOM                                      
                                           ON (PPL_LINE.UOM_ID = TRX_UOM.UOM_ID)	
                      WHERE PPL_HDR.PPL_HDR_ID  =$P{PPL_HDR_ID}
GROUP BY
mtl_type_d.PRD_TYPE_DESC
,mtl_modality_d.MODALITY_DESC
,mtl_category_d.CATEGORY_DESC
,mtl_color_d.COLOR_DESC
 ,INV_ITEM.LENGTH
 ,INV_ITEM.BREADTH    
 ,INV_ITEM.THICKNESS 
,PPL_LINE.PPL_LINE_NO
 ,PPL_LINE.FROM_CRT_NO
,PPL_LINE.TO_CRT_NO
 ,PPL_LINE.PPL_LINE_REMARK
,INV_ITEM.item_class_id
  ,item_desc
,TRX_UOM.UOM_SYMBOL,INV_ITEM.length,INV_ITEM.breadth,INV_ITEM.height,PPL_LINE.UOM_ID]]></queryString>

	<field name="ITEM_SIZE" class="java.lang.String"/>
