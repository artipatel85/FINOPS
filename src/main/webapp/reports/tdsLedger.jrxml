<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TrialDetailed" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="companyId" class="java.lang.Integer"/>
	<parameter name="acctYear" class="java.lang.String"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="ccId" class="java.lang.String"/>
	<parameter name="startDate" class="java.lang.String"/>
	<parameter name="endDate" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT cc1.ACCT_NAME tdsacct,cc2.ACCT_NAME cashbank,SUM(je.ACCOUNTED_DR) tdsacctwise
FROM gl_je_f je
LEFT OUTER JOIN gl_code_combination_d cc1 ON (cc1.CODE_COMBINATION_ID=je.CODE_COMBINATION_ID)
LEFT OUTER JOIN gl_code_combination_d cc2 ON (cc2.CODE_COMBINATION_ID=je.CASH_BANK)
WHERE je.CODE_COMBINATION_ID = 1567 AND je.ACCT_YEAR=$P{acctYear}
AND je.je_date between $P{startDate} AND $P{endDate}
AND je.CASH_BANK LIKE $P{ccId}
GROUP BY cc1.ACCT_NAME,cc2.ACCT_NAME]]>
	</queryString>
	<field name="tdsacct" class="java.lang.String"/>
	<field name="cashbank" class="java.lang.String"/>
	<field name="tdsacctwise" class="java.math.BigDecimal"/>
	<variable name="CLOSING_BAL" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{tdsacctwise}]]></variableExpression>
	</variable>
	<variable name="TOTAL_CLOSE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{tdsacctwise}]]></variableExpression>
	</variable>
	<variable name="TOTAL_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{tdsacctwise}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="66" splitType="Stretch">
			<textField>
				<reportElement x="0" y="23" width="211" height="43"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{address}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="3" width="211" height="20"/>
				<textElement>
					<font fontName="Arial" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{company}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band height="49" splitType="Stretch">
			<staticText>
				<reportElement x="155" y="7" width="260" height="17"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[DETAILED TRIAL BALANCE : TDS LEDGER]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="29" width="65" height="15"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Printed On:]]></text>
			</staticText>
			<textField pattern="EEEEE dd MMMMM yyyy">
				<reportElement x="445" y="29" width="110" height="15"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="4" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="1" y="24" width="555" height="1"/>
			</line>
			<line>
				<reportElement x="0" y="46" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="1.5" lineStyle="Double"/>
				</graphicElement>
			</line>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="22" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="135" height="15"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[ACCOUNT]]></text>
			</staticText>
			<staticText>
				<reportElement x="211" y="0" width="62" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[OPENING]]></text>
			</staticText>
			<staticText>
				<reportElement x="299" y="0" width="62" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[DEBIT]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="0" width="62" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CREDIT]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="19" width="555" height="1"/>
				<graphicElement>
					<pen lineStyle="Solid"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="486" y="0" width="69" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CLOSING]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="21" splitType="Stretch">
			<textField>
				<reportElement x="0" y="1" width="135" height="16"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cashbank}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="20" width="555" height="1"/>
			</line>
			<textField>
				<reportElement x="299" y="3" width="61" height="16"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tdsacctwise}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="8" splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band height="13" splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band height="24" splitType="Stretch">
			<staticText>
				<reportElement x="72" y="6" width="62" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="23" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.75" lineStyle="Double"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement x="485" y="6" width="69" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{TOTAL_CLOSE}.doubleValue() < 0 ? $V{TOTAL_CLOSE}.negate() + " Cr" : $V{TOTAL_CLOSE} + " Dr"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="298" y="6" width="62" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="9"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TOTAL_DEBIT}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="3" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.75" lineStyle="Double"/>
				</graphicElement>
			</line>
		</band>
	</summary>
</jasperReport>
